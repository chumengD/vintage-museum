<td id="mwA3s"><b id="mwA3w">Windows Media Player</b></td><td id="mwA30">April 19, 2000</td><td id="mwA34"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Mobile#Pocket_PC_2000" title="Windows Mobile" id="mwA38">Pocket PC 2000</a></td><td data-sort-value="" style="background: var(--background-color-interactive, #ececec); color: var(--color-base, inherit); vertical-align: middle; text-align: center; " class="table-na" typeof="mw:Transclusion" about="#mwt216" id="mwA4A" data-mw='{"parts":["|| ",{"template":{"target":{"wt":"N/A","href":"./Template:N/A"},"params":{},"i":0}}]}'><span aria-hidden="true">—</span><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1385126657" about="#mwt217" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Screen reader–only/styles.css"}}'/><span class="sr-only">N/a</span></td></tr>
