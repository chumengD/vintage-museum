					</div>
					
					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="en" dir="ltr" data-mw-parsoid-version="0.25.0.0-alpha1" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"short description","href":"./Template:Short_description"},"params":{"1":{"wt":"Media player and media library application by Microsoft"}},"i":0}}]}'>Media player and media library application by Microsoft</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_matches_Wikidata"/></span>
<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" id="mwAw" data-mw='{"parts":[{"template":{"target":{"wt":"about","href":"./Template:About"},"params":{"1":{"wt":"the original version used prior to Windows 11"},"2":{"wt":"its successor"},"3":{"wt":"Windows Media Player (2022)"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1368532237" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .hatnote{font-style:italic}.mw-parser-output div.hatnote{padding-left:1.6em;margin-bottom:0.5em}.mw-parser-output .hatnote i{font-style:normal}.mw-parser-output .hatnote+.mw-empty-elt+.hatnote{margin-top:-0.5em}@media print{body.ns-0 .mw-parser-output .hatnote{display:none!important}}</style></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt2" id="mwBA">This article is about the original version used prior to Windows 11. For its successor, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Media_Player_(2022)" title="Windows Media Player (2022)">Windows Media Player (2022)</a>.</div>
<span class="mw-empty-elt" about="#mwt4" typeof="mw:Transclusion" id="mwBQ" data-mw='{"parts":[{"template":{"target":{"wt":"redirect","href":"./Template:Redirect"},"params":{"1":{"wt":"WMP"}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1368532237" about="#mwt5" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'/></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt4" id="mwBg">"WMP" redirects here. For other uses, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/WMP_(disambiguation)" title="WMP (disambiguation)" class="mw-disambig">WMP (disambiguation)</a>.</div>
<span class="mw-empty-elt" about="#mwt6" typeof="mw:Transclusion" id="mwBw" data-mw='{"parts":[{"template":{"target":{"wt":"distinguish","href":"./Template:Distinguish"},"params":{"1":{"wt":"Windows Media Center"}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1368532237" about="#mwt7" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'/></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt6" id="mwCA">Not to be confused with <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Media_Center" title="Windows Media Center">Windows Media Center</a>.</div>
<span class="mw-empty-elt" about="#mwt8" typeof="mw:Transclusion" id="mwCQ" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox software\n","href":"./Template:Infobox_software"},"params":{"title":{"wt":"Windows Media Player Legacy"},"logo":{"wt":"Windows Media Player 12 Logo.png"},"logo_size":{"wt":"64px"},"screenshot":{"wt":"File:Windows Media Player 12, under Windows 11.png"},"screenshot_size":{"wt":"300px"},"caption":{"wt":"Windows Media Player 12 running on [[Windows 11]]"},"developer":{"wt":"[[Microsoft]]"},"replaces":{"wt":"[[ActiveMovie|ActiveMovie Control]], [[CD Player (Windows)|CD Player]], [[DVD Player (Windows)|DVD Player]], [[NetShow]]"},"replaced_by":{"wt":"[[Groove Music]], [[Microsoft Movies &amp; TV]], [[Windows Media Player (2022)]]"},"included with":{"wt":"{{Plainlist|\n* [[Windows 3.0#Windows 3.0 with Multimedia Extensions|Windows 3.0 MME]] and [[Windows 3.1]]\n* [[Windows 9x]]\n* [[Windows 2000]], [[Windows Me]], [[Windows XP]], [[Windows Vista]], [[Windows 7]], [[Windows 8]], [[Windows 8.1]], [[Windows 10]], [[Windows 11]]{{efn|Except for \"N\" and \"KN\" editions of Windows, as well as [[Windows RT]]}}\n* [[Windows CE]] and [[Windows Mobile]]\n* [[Mac OS 8]] and [[Mac OS 9|9]]\n}}"},"operating system":{"wt":"{{hlist|[[Windows NT 4.0]]|[[System 7|Mac OS 7]]|[[macOS|Mac OS X]]|[[Solaris (operating system)|Solaris]]}}"},"genre":{"wt":"[[Media player (application software)|Media player]]"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1385617415" typeof="mw:Extension/templatestyles" about="#mwt9" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-outpu