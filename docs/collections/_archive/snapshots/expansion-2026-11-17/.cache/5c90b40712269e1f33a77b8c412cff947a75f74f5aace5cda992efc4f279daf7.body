<th id="mwBKE"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Data_storage_device" title="Data storage device" class="mw-redirect" id="mwBKI">Data storage device</a> free space</th>
<td colspan="3" id="mwBKM"><span class="mw-empty-elt" about="#mwt777" typeof="mw:Transclusion" id="mwBKQ" data-mw='{"parts":[{"template":{"target":{"wt":"ubl\n  ","href":"./Template:Ubl"},"params":{"1":{"wt":"500&amp;nbsp;MB\n  "},"2":{"wt":"ESR 115: 200&amp;nbsp;MB\n"}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1126788409" about="#mwt778" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Plainlist/styles.css"},"body":{"extsrc":""}}'/></span><div class="plainlist" about="#mwt777" id="mwBKU"><ul><li>500<span typeof="mw:Entity"> </span>MB</li><li>ESR 115: 200<span typeof="mw:Entity"> </span>MB</li></ul></div></td>
<td id="mwBKY">80<span typeof="mw:Entity" id="mwBKc"> </span>MB</td>
<td id="mwBKg">~128<span typeof="mw:Entity" id="mwBKk"> </span>MB<sup about="#mwt779" class="mw-ref reference" id="cite_ref-ios_req_181-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"ios_req"}}'><a href="#cite_note-ios_req-181" id="mwBKo"><span class="mw-reflink-text" id="mwBKs"><span class="cite-bracket" id="mwBKw">[</span>181<span class="cite-bracket" id="mwBK0">]</span></span></a></sup></td></tr>
<tr id="mwBK4">
<th id="mwBK8">Operating system</th>
<td id="mwBLA"><span class="mw-empty-elt" about="#mwt780" typeof="mw:Transclusion" id="mwBLE" data-mw='{"parts":[{"template":{"target":{"wt":"ubl\n  ","href":"./Template:Ubl"},"params":{"1":{"wt":"[[Windows 10]] or later\n  "},"2":{"wt":"[[Windows Server 2016]] or later&lt;ref name=\"sysreq 116.0\" />\n  "},"3":{"wt":"ESR 115: [[Windows 7]], [[Server 2008 R2]], [[Windows 8|8]], [[Server 2012]], [[Windows 8.1|8.1]] and [[Windows Server 2012 R2|Server 2012 R2]]\n"}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1126788409" about="#mwt781" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Plainlist/styles.css"},"body":{"extsrc":""}}'/></span><div class="plainlist" about="#mwt780" id="mwBLI"><ul><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_10" title="Windows 10">Windows 10</a> or later</li><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Server_2016" title="Windows Server 2016">Windows Server 2016</a> or later<sup about="#mwt782" class="mw-ref reference" id="cite_ref-sysreq_116.0_176-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"sysreq 116.0"}}'><a href="#cite_note-sysreq_116.0-176" id="mwBLM"><span class="mw-reflink-text" id="mwBLQ"><span class="cite-bracket" id="mwBLU">[</span>176<span class="cite-bracket" id="mwBLY">]</span></span></a></sup></li><li>ESR 115: <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_7" title="Windows 7">Windows 7</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Server_2008_R2" title="Server 2008 R2" class="mw-redirect">Server 2008 R2</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_8" title="Windows 8">8</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Server_2012" title="Server 2012" class="mw-redirect">Server 2012</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_8.1" title="Windows 8.1">8.1</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Server_2012_R2" title="Windows Server 2012 R2">Server 2012 R2</a></li></ul></div></td>
<td id="mwBLc">
<p id="mwBLg"><b id="mwBLk">Minimum</b></p>
<ul id="mwBLo"><li id="mwBLs"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Glibc" title="Glibc" id="mwBLw">glibc</a> 2.17 or newer<sup about="#mwt786" class="mw-ref reference" id="cite_ref-182" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-182"}}'><a href="#cite_note-182" id="mwBL0"><span class="mw-reflink-text" id="mwBL4"><span class="cite-bracket" id="mwBL8">[</span>182<span class="cite-bracket" id="mwBMA">]</span></span></a></sup></li>
<li id="mwBME"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/GTK" title="GTK" id="mwBMI">GTK</a> 3.14 or newer</li>
<li id="mwBMM">libglib 2.42 or newer</li>
<li id="mwBMQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/C++_Standard_Library" title="C++ Standard Library" id="mwBMU">libstdc++</a> 4.8.1 or newer</li>
<li id="mwBMY"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/X.Org_Server" title="X.Org Server" id="mwBMc">X.Org</a> 1.0 or newer</li></ul>

<p id="mwBMg"><b id="mwBMk">Recommended</b></p>
<ul id="mwBMo"><li id="mwBMs"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/DBus" title="DBus" class="mw-redirect" id="mwBMw">DBus</a> 1.0 or newer</li>
<li id="mwBM0"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Glibc" title="Glibc" id="mwBM4">glibc</a> 2.28 or newer on ARM64</li>
<li id="mwBM8"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/C++_Standard_Library" title="C++ Standard Library" id="mwBNA">libstdc++</a> 6.0 or newer on ARM64</li>
<li id="mwBNE"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/NetworkManager" title="NetworkManager" id="mwBNI">NetworkManager</a> 0.7 or newer</li>
<li id="mwBNM"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/PulseAudio" title="PulseAudio" id="mwBNQ">PulseAudio</a></li>
<li id="mwBNU"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/X.Org_Server" title="X.Org Server" id="mwBNY">X.Org</a> 1.7 or newer</li></ul></td>
<td id="mwBNc"><span class="mw-empty-elt" about="#mwt787" typeof="mw:Transclusion" id="mwBNg" data-mw='{"parts":[{"template":{"target":{"wt":"ubl\n  ","href":"./Template:Ubl"},"params":{"1":{"wt":"[[macOS Catalina]] or newer&lt;ref name=\"sysreq 116.0\" />\n  "},"2":{"wt":"ESR 115: [[macOS Sierra]]–[[macOS Mojave]]\n"}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1126788409" about="#mwt788" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Plainlist/styles.css"},"body":{"extsrc":""}}'/></span><div class="plainlist" about="#mwt787" id="mwBNk"><ul><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/MacOS_Catalina" title="MacOS Catalina">macOS Catalina</a> or newer<sup about="#mwt789" class="mw-ref reference" id="cite_ref-sysreq_116.0_176-2" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"sysreq 116.0"}}'><a href="#cite_note-sysreq_116.0-176" id="mwBNo"><span class="mw-reflink-text" id="mwBNs"><span class="cite-bracket" id="mwBNw">[</span>176<span class="cite-bracket" id="mwBN0">]</span></span></a></sup></li><li>ESR 115: <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/MacOS_Sierra" title="MacOS Sierra">macOS Sierra</a>–<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/MacOS_Mojave" title="MacOS Mojave">macOS Mojave</a></li></ul></div></td>
<td id="mwBN4"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Android_Oreo" title="Android Oreo" id="mwBN8">Android Oreo</a> or newer<sup about="#mwt793" class="mw-ref reference" id="cite_ref-183" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-183"}}'><a href="#cite_note-183" id="mwBOA"><span class="mw-reflink-text" id="mwBOE"><span class="cite-bracket" id="mwBOI">[</span>183<span class="cite-bracket" id="mwBOM">]</span></span></a></sup></td>
<td id="mwBOQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IOS_15" title="IOS 15" id="mwBOU">iOS 15</a> or later<sup about="#mwt796" class="mw-ref reference" id="cite_ref-ios_req_181-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"ios_req"},"body":{"id":"mw-reference-text-cite_note-ios_req-181"}}'><a href="#cite_note-ios_req-181" id="mwBOY"><span class="mw-reflink-text" id="mwBOc"><span class="cite-bracket" id="mwBOg">[</span>181<span class="cite-bracket" id="mwBOk">]</span></span></a></sup></td></tr>
</tbody></table><!-- If this may seem confusing, then Android 2.2 and/or ARMv6 are no longer supported. See Talk. Confirmed there.-->

<section data-mw-section-id="18" id="mwBOo" aria-labelledby="Microsoft_Windows"><div class="mw-heading mw-heading3"><h3 id="Microsoft_Windows">Microsoft Windows</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Firefox&amp;action=edit&amp;section=18" title="Edit section: Microsoft Windows"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<figure class="mw-default-size" typeof="mw:File/Thumb" id="mwBOs"><a href="https://en.wikipedia.org/wiki/File:Firefox_146.0.1_on_Windows_11_screenshot.webp" class="mw-file-description" id="mwBOw"><img resource="https://en.wikipedia.org/wiki/File:Firefox_146.0.1_on_Windows_11_screenshot.webp" src="//thumb.wikimedia.org/wikipedia/commons/thumb/0/04/Firefox_146.0.1_on_Windows_11_screenshot.webp/250px-Firefox_146.0.1_on_Windows_11_screenshot.webp?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/0/04/Firefox_146.0.1_on_Windows_11_screenshot.webp/500px-Firefox_146.0.1_on_Windows_11_screenshot.webp?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="1227" data-file-height="690" data-file-type="bitmap" height="141" width="250" class="mw-file-element" id="mwBO0"/></a><figcaption id="mwBO4">Firefox 146 on <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_11" title="Windows 11" id="mwBO8">Windows 11</a></figcaption></figure>

<p id="mwBPA">Firefox 1.0 was released for <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_95" title="Windows 95" id="mwBPE">Windows 95</a>, as well as <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_NT_4.0" title="Windows NT 4.0" id="mwBPI">Windows NT 4.0</a> or later. Some users reported the 1.x builds were operable (but not installable) on <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_NT_3.51" title="Windows NT 3.51" id="mwBPM">Windows NT 3.51</a>.<sup about="#mwt799" class="mw-ref reference" id="cite_ref-184" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-184"}}'><a href="#cite_note-184" id="mwBPQ"><span class="mw-reflink-text" id="mwBPU"><span class="cite-bracket" id="mwBPY">[</span>184<span class="cite-bracket" id="mwBPc">]</span></span></a></sup></p>

<p id="mwBPg">The version 42.0 release includes the first <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/X64" title="X64" class="mw-redirect" id="mwBPk">x64</a> build. It required <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_7" title="Windows 7" id="mwBPo">Windows 7</a> or <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Server_2008_R2" title="Server 2008 R2" class="mw-redirect" id="mwBPs">Server 2008 R2</a>.<sup about="#mwt802" class="mw-ref reference" id="cite_ref-185" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-185"}}'><a href="#cite_note-185" id="mwBPw"><span class="mw-reflink-text" id="mwBP0"><span class="cite-bracket" id="mwBP4">[</span>185<span class="cite-bracket" id="mwBP8">]</span></span></a></sup> Starting from version 49.0, Firefox for Windows requires and uses the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/SSE2" title="SSE2" id="mwBQA">SSE2</a> instruction set.</p>

<p id="mwBQE">In September 2013, Mozilla released a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Universal_Windows_Platform_apps" title="Universal Windows Platform apps" id="mwBQI">Metro-style version</a> of Firefox, optimized for <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Touchscreen" title="Touchscreen" id="mwBQM">touchscreen</a> use, on the "Aurora" release channel. However, on March 14, 2014, Mozilla cancelled the project because of a lack of user adoption.<sup about="#mwt805" class="mw-ref reference" id="cite_ref-fx-metrocancelled_186-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"fx-metrocancelled"},"body":{"id":"mw-reference-text-cite_note-fx-metrocancelled-186"}}'><a href="#cite_note-fx-metrocancelled-186" id="mwBQQ"><span class="mw-reflink-text" id="mwBQU"><span class="cite-bracket" id="mwBQY">[</span>186<span class="cite-bracket" id="mwBQc">]</span></span></a></sup><sup about="#mwt808" class="mw-ref reference" id="cite_ref-mozandroid-devices_187-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"mozandroid-devices"},"body":{"id":"mw-reference-text-cite_note-mozandroid-devices-187"}}'><a href="#cite_note-mozandroid-devices-187" id="mwBQg"><span class="mw-reflink-text" id="mwBQk"><span class="cite-bracket" id="mwBQo">[</span>187<span class="cite-bracket" id="mwBQs">]</span></span></a></sup><sup about="#mwt811" class="mw-ref reference" id="cite_ref-engadget-firefoxmetro_188-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"engadget-firefoxmetro"},"body":{"id":"mw-reference-text-cite_note-engadget-firefoxmetro-188"}}'><a href="#cite_note-engadget-firefoxmetro-188" id="mwBQw"><span class="mw-reflink-text" id="mwBQ0"><span class="cite-bracket" id="mwBQ4">[</span>188<span class="cite-bracket" id="mwBQ8">]</span></span></a></sup></p>

<p id="mwBRA">In March 2017, Firefox 52 ESR, the last version of the browser for <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_XP" title="Windows XP" id="mwBRE">Windows XP</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Vista" title="Windows Vista" id="mwBRI">Windows Vista</a>, was released.<sup about="#mwt814" class="mw-ref reference" id="cite_ref-189" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-189"}}'><a href="#cite_note-189" id="mwBRM"><span class="mw-reflink-text" id="mwBRQ"><span class="cite-bracket" id="mwBRU">[</span>189<span class="cite-bracket" id="mwBRY">]</span></span></a></sup> Support for Firefox 52 ESR ended in June 2018.<sup about="#mwt817" class="mw-ref reference" id="cite_ref-190" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-190"}}'><a href="#cite_note-190" id="mwBRc"><span class="mw-reflink-text" id="mwBRg"><span class="cite-bracket" id="mwBRk">[</span>190<span class="cite-bracket" id="mwBRo">]</span></span></a></sup></p>

<p id="mwBRs">Traditionally, installing the Windows version of Firefox entails visiting the Firefox website and downloading an installer package, depending on the desired localization and system architecture. In November 2021, Mozilla made Firefox available on the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Microsoft_Store" title="Microsoft Store" id="mwBRw">Microsoft Store</a>. The Store-distributed package does not interfere with the traditional installation.<sup about="#mwt820" class="mw-ref reference" id="cite_ref-191" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-191"}}'><a href="#cite_note-191" id="mwBR0"><span class="mw-reflink-text" id="mwBR4"><span class="cite-bracket" id="mwBR8">[</span>191<span class="cite-bracket" id="mwBSA">]</span></span></a></sup><sup about="#mwt823" class="mw-ref reference" id="cite_ref-192" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-192"}}'><a href="#cite_note-192" id="mwBSE"><span class="mw-reflink-text" id="mwBSI"><span class="cite-bracket" id="mwBSM">[</span>192<span class="cite-bracket" id="mwBSQ">]</span></span></a></sup></p>

<p id="mwBSU">The last version of Firefox for Windows 7 and 8 is Firefox 115 ESR, which was released in July 2023.<sup about="#mwt827" class="mw-ref reference" id="cite_ref-193" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-193"}}'><a href="#cite_note-193" id="mwBSY"><span class="mw-reflink-text" id="mwBSc"><span class="cite-bracket" id="mwBSg">[</span>193<span class="cite-bracket" id="mwBSk">]</span></span></a></sup> Its <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/End-of-life_product" title="End-of-life product" class="mw-redirect" id="mwBSo">end-of-life</a> was initially planned to be in October 2024,<sup about="#mwt830" class="mw-ref reference" id="cite_ref-194" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-194"}}'><a href="#cite_note-194" id="mwBSs"><span class="mw-reflink-text" id="mwBSw"><span class="cite-bracket" id="mwBS0">[</span>194<span class="cite-bracket" id="mwBS4">]</span></span></a></sup> however in July 2024, a Mozilla employee announced in a comment on <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Reddit" title="Reddit" id="mwBS8">Reddit</a> that the company was considering extending support beyond the initial date, with the duration of the extension yet to be defined.<link rel="mw:PageProp/Category" href="./Category:All_articles_with_unsourced_statements" about="#mwt824" typeof="mw:Transclusion" id="mwBTA" data-mw='{"parts":[{"template":{"target":{"wt":"citation needed","href":"./Template:Citation_needed"},"params":{"date":{"wt":"March 2025"}},"i":0}}]}'/><link rel="mw:PageProp/Category" href="./Category:Articles_with_unsourced_statements_from_March_2025" about="#mwt824"/><sup class="noprint Inline-Template Template-Fact" style="white-space:nowrap;" about="#mwt824" id="mwBTE"><span typeof="mw:Entity">[</span><i><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wikipedia:Citation_needed" title="Wikipedia:Citation needed"><span title="This claim needs references to reliable sources. (March 2025)">citation needed</span></a></i><span typeof="mw:Entity">]</span></sup> In September 2024, the extension was announced for an initial period of six months.<sup about="#mwt833" class="mw-ref reference" id="cite_ref-:2_195-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":2"},"body":{"id":"mw-reference-text-cite_note-:2-195"}}'><a href="#cite_note-:2-195" id="mwBTI"><span class="mw-reflink-text" id="mwBTM"><span class="cite-bracket" id="mwBTQ">[</span>195<span class="cite-bracket" id="mwBTU">]</span></span></a></sup> In the release calendar page, a note states that Mozilla will re-evaluate the situation in early 2025 to see if another extension will be needed or not and statute about 115 ESR end-of-life then.<sup about="#mwt836" class="mw-ref reference" id="cite_ref-196" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-196"}}'><a href="#cite_note-196" id="mwBTY"><span class="mw-reflink-text" id="mwBTc"><span class="cite-bracket" id="mwBTg">[</span>196<span class="cite-bracket" id="mwBTk">]</span></span></a></sup> This extension has been renewed three more times, on February 18, 2025, and on September 3, 2025, for six additional months each time, and on March 10, 2026 for five additional months, which led the end-of-life date to August 2026.<sup about="#mwt839" class="mw-ref reference" id="cite_ref-:1_197-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":1"},"body":{"id":"mw-reference-text-cite_note-:1-197"}}'><a href="#cite_note-:1-197" id="mwBTo"><span class="mw-reflink-text" id="mwBTs"><span class="cite-bracket" id="mwBTw">[</span>197<span class="cite-bracket" id="mwBT0">]</span></span></a></sup>  In early July 2026 this was extended again to March 2027.<sup about="#mwt842" class="mw-ref reference" id="cite_ref-115march2027_198-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"115march2027"},"body":{"id":"mw-reference-text-cite_note-115march2027-198"}}'><a href="#cite_note-115march2027-198" id="mwBT4"><span class="mw-reflink-text" id="mwBT8"><span class="cite-bracket" id="mwBUA">[</span>198<span class="cite-bracket" id="mwBUE">]</span></span></a></sup></p>

</section><section data-mw-section-id="19" id="mwBUI" aria-labelledby="macOS"><div class="mw-heading mw-heading3"><h3 id="macOS">macOS</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Firefox&amp;action=edit&amp;section=19" title="Edit section: macOS"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<figure class="mw-default-size" typeof="mw:File/Thumb" id="mwBUM"><a href="https://en.wikipedia.org/wiki/File:Firefox_136_screenshot,_macOS_Sonoma.png" class="mw-file-description" id="mwBUQ"><img resource="https://en.wikipedia.org/wiki/File:Firefox_136_screenshot,_macOS_Sonoma.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/c/ca/Firefox_136_screenshot%2C_macOS_Sonoma.png/250px-Firefox_136_screenshot%2C_macOS_Sonoma.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/c/ca/Firefox_136_screenshot%2C_macOS_Sonoma.png/500px-Firefox_136_screenshot%2C_macOS_Sonoma.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="1392" data-file-height="887" data-file-type="bitmap" height="159" width="250" class="mw-file-element" id="mwBUU"/></a><figcaption id="mwBUY">Firefox 136 on <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/MacOS_Sonoma" title="MacOS Sonoma" id="mwBUc">macOS Sonoma</a></figcaption></figure><!-- That's a very old Firefox (and macOS) version, no longer supported, update? -->
<p id="mwBUg">The first official release (Firefox version 1.0) supported <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/MacOS" title="MacOS" id="mwBUk">macOS</a> (then called Mac OS X) on the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/PowerPC" title="PowerPC" id="mwBUo">PowerPC</a> architecture. Mac OS X builds for the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IA-32" title="IA-32" id="mwBUs">IA-32</a> architecture became available via a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Universal_binary" title="Universal binary" id="mwBUw">universal binary</a>, which debuted with Firefox 1.5.0.2 in 2006.</p>

<p id="mwBU0">Starting with version 4.0, Firefox was released for the x64 architecture, to which macOS had migrated.<sup about="#mwt845" class="mw-ref reference" id="cite_ref-maclinux64_199-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"maclinux64"},"body":{"id":"mw-reference-text-cite_note-maclinux64-199"}}'><a href="#cite_note-maclinux64-199" id="mwBU4"><span class="mw-reflink-text" id="mwBU8"><span class="cite-bracket" id="mwBVA">[</span>199<span class="cite-bracket" id="mwBVE">]</span></span></a></sup> Version 4.0 also dropped support for PowerPC architecture, although other projects continued development of a PowerPC version of Firefox.<sup about="#mwt848" class="mw-ref reference" id="cite_ref-200" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-200"}}'><a href="#cite_note-200" id="mwBVI"><span class="mw-reflink-text" id="mwBVM"><span class="cite-bracket" id="mwBVQ">[</span>200<span class="cite-bracket" id="mwBVU">]</span></span></a></sup></p>

<p id="mwBVY">Firefox was originally released for Mac OS X 10.0 and higher.<sup about="#mwt851" class="mw-ref reference" id="cite_ref-201" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-201"}}'><a href="#cite_note-201" id="mwBVc"><span class="mw-reflink-text" id="mwBVg"><span class="cite-bracket" id="mwBVk">[</span>201<span class="cite-bracket" id="mwBVo">]</span></span></a></sup> The minimum OS then increased to Mac OS X 10.2 in Firefox 1.5 and 10.4 in Firefox 3.<sup about="#mwt854" class="mw-ref reference" id="cite_ref-202" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-202"}}'><a href="#cite_note-202" id="mwBVs"><span class="mw-reflink-text" id="mwBVw"><span class="cite-bracket" id="mwBV0">[</span>202<span class="cite-bracket" id="mwBV4">]</span></span></a></sup><sup about="#mwt857" class="mw-ref reference" id="cite_ref-203" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-203"}}'><a href="#cite_note-203" id="mwBV8"><span class="mw-reflink-text" id="mwBWA"><span class="cite-bracket" id="mwBWE">[</span>203<span class="cite-bracket" id="mwBWI">]</span></span></a></sup> Firefox 4 dropped support for Mac OS X 10.4 and PowerPC Macs, and Firefox 17 dropped support for Mac OS X 10.5 entirely.<sup about="#mwt860" class="mw-ref reference" id="cite_ref-204" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-204"}}'><a href="#cite_note-204" id="mwBWM"><span class="mw-reflink-text" id="mwBWQ"><span class="cite-bracket" id="mwBWU">[</span>204<span class="cite-bracket" id="mwBWY">]</span></span></a></sup><sup about="#mwt863" class="mw-ref reference" id="cite_ref-205" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-205"}}'><a href="#cite_note-205" id="mwBWc"><span class="mw-reflink-text" id="mwBWg"><span class="cite-bracket" id="mwBWk">[</span>205<span class="cite-bracket" id="mwBWo">]</span></span></a></sup> The system requirements were left unchanged until 2016, when Firefox 49 dropped support for Mac OS X 10.6–10.8.<sup about="#mwt866" class="mw-ref reference" id="cite_ref-206" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-206"}}'><a href="#cite_note-206" id="mwBWs"><span class="mw-reflink-text" id="mwBWw"><span class="cite-bracket" id="mwBW0">[</span>206<span class="cite-bracket" id="mwBW4">]</span></span></a></sup><sup about="#mwt869" class="mw-ref reference" id="cite_ref-207" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-207"}}'><a href="#cite_note-207" id="mwBW8"><span class="mw-reflink-text" id="mwBXA"><span class="cite-bracket" id="mwBXE">[</span>207<span class="cite-bracket" id="mwBXI">]</span></span></a></sup> Mozilla ended support for OS X 10.9–10.11 in Firefox 79, with those users being supported on the Firefox 78 ESR branch until November 2021.<sup about="#mwt872" class="mw-ref reference" id="cite_ref-208" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-208"}}'><a href="#cite_note-208" id="mwBXM"><span class="mw-reflink-text" id="mwBXQ"><span class="cite-bracket" id="mwBXU">[</span>208<span class="cite-bracket" id="mwBXY">]</span></span></a></sup><sup about="#mwt875" class="mw-ref reference" id="cite_ref-209" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-209"}}'><a href="#cite_note-209" id="mwBXc"><span class="mw-reflink-text" id="mwBXg"><span class="cite-bracket" id="mwBXk">[</span>209<span class="cite-bracket" id="mwBXo">]</span></span></a></sup><sup about="#mwt878" class="mw-ref reference" id="cite_ref-210" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-210"}}'><a href="#cite_note-210" id="mwBXs"><span class="mw-reflink-text" id="mwBXw"><span class="cite-bracket" id="mwBX0">[</span>210<span class="cite-bracket" id="mwBX4">]</span></span></a></sup> Most recently, Mozilla ended support for <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/MacOS_10.12" title="MacOS 10.12" class="mw-redirect" id="mwBX8">macOS 10.12</a>–<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/MacOS_Mojave" title="MacOS Mojave" id="mwBYA">10.14</a> in Firefox 116, with those users being supported on the Firefox 115 ESR branch until late 2024. In September 2024, however, an extension was announced for the 115 ESR branch for an initial period of six months.<sup about="#mwt879" class="mw-ref reference" id="cite_ref-:2_195-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":2"}}'><a href="#cite_note-:2-195" id="mwBYE"><span class="mw-reflink-text" id="mwBYI"><span class="cite-bracket" id="mwBYM">[</span>195<span class="cite-bracket" id="mwBYQ">]</span></span></a></sup> This extension has been renewed three more times, on February 18, 2025, and on September 3, 2025, for six additional months each time, and on March 10, 2026 for five additional months, which led the end-of-life date to August 2026.<sup about="#mwt880" class="mw-ref reference" id="cite_ref-:1_197-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":1"}}'><a href="#cite_note-:1-197" id="mwBYU"><span class="mw-reflink-text" id="mwBYY"><span class="cite-bracket" id="mwBYc">[</span>197<span class="cite-bracket" id="mwBYg">]</span></span></a></sup>  In early July 2026 this was extended again to March 2027.<sup about="#mwt881" class="mw-ref reference" id="cite_ref-115march2027_198-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"115march2027"}}'><a href="#cite_note-115march2027-198" id="mwBYk"><span class="mw-reflink-text" id="mwBYo"><span class="cite-bracket" id="mwBYs">[</span>198<span class="cite-bracket" id="mwBYw">]</span></span></a></sup></p>

</section><section data-mw-section-id="20" id="mwBY0" aria-labelledby="Linux"><div class="mw-heading mw-heading3"><h3 id="Linux">Linux</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Firefox&amp;action=edit&amp;section=20" title="Edit section: Linux"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<figure class="mw-default-size" typeof="mw:File/Thumb" id="mwBY4"><a href="https://en.wikipedia.org/wiki/File:Firefox_145.0_on_Linux_screenshot.webp" class="mw-file-description" id="mwBY8"><img resource="https://en.wikipedia.org/wiki/File:Firefox_145.0_on_Linux_screenshot.webp" src="//thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Firefox_145.0_on_Linux_screenshot.webp/250px-Firefox_145.0_on_Linux_screenshot.webp?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/1/12/Firefox_145.0_on_Linux_screenshot.webp/500px-Firefox_145.0_on_Linux_screenshot.webp?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="1277" data-file-height="753" data-file-type="bitmap" height="147" width="250" class="mw-file-element" id="mwBZA"/></a><figcaption id="mwBZE">Firefox 145 on <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/OpenSUSE" title="OpenSUSE" id="mwBZI">openSUSE</a></figcaption></figure>
<figure class="mw-default-size" typeof="mw:File/Thumb" id="mwBZM"><span id="mwBZQ"><video poster="//thumb.wikimedia.org/wikipedia/commons/thumb/5/5f/Firefox_136_on_Fedora_41%2C_browsing_the_English_Wikipedia_site.webm/250px--Firefox_136_on_Fedora_41%2C_browsing_the_English_Wikipedia_site.webm.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser" controls="" preload="none" data-mw-tmh="" height="141" width="250" resource="https://en.wikipedia.org/wiki/File:Firefox_136_on_Fedora_41,_browsing_the_English_Wikipedia_site.webm" data-durationhint="47" class="mw-file-element" id="mwBZU"><source src="//upload.wikimedia.org/wikipedia/commons/transcoded/5/5f/Firefox_136_on_Fedora_41%2C_browsing_the_English_Wikipedia_site.webm/Firefox_136_on_Fedora_41%2C_browsing_the_English_Wikipedia_site.webm.240p.vp9.webm" type='video/webm; codecs="vp9, opus"' data-width="426" data-height="240" data-transcodekey="240p.vp9.webm" id="mwBZY"/><source src="//upload.wikimedia.org/wikipedia/commons/transcoded/5/5f/Firefox_136_on_Fedora_41%2C_browsing_the_English_Wikipedia_site.webm/Firefox_136_on_Fedora_41%2C_browsing_the_English_Wikipedia_site.webm.360p.mpeg4.mov" type='video/quicktime; codecs="mp4v"' data-width="640" data-height="360" data-transcodekey="360p.mpeg4.mov" id="mwBZc"/><source src="//upload.wikimedia.org/wikipedia/commons/transcoded/5/5f/Firefox_136_on_Fedora_41%2C_browsing_the_English_Wikipedia_site.webm/Firefox_136_on_Fedora_41%2C_browsing_the_English_Wikipedia_site.webm.480p.vp9.webm" type='video/webm; codecs="vp9, opus"' data-width="854" data-height="480" data-transcodekey="480p.vp9.webm" id="mwBZg"/><source src="//upload.wikimedia.org/wikipedia/commons/transcoded/5/5f/Firefox_136_on_Fedora_41%2C_browsing_the_English_Wikipedia_site.webm/Firefox_136_on_Fedora_41%2C_browsing_the_English_Wikipedia_site.webm.1080p.vp9.webm" type='video/webm; codecs="vp9, opus"' data-width="1920" data-height="1080" data-transcodekey="1080p.vp9.webm" id="mwBZk"/></video></span><figcaption id="mwBZo">Opening Wikipedia main page with Mozilla Firefox 136 on <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Fedora_Linux" title="Fedora Linux" id="mwBZs">Fedora Linux</a> 41</figcaption></figure>
<p id="mwBZw">Since its inception, Firefox for Linux has supported the 32-bit memory architecture of the IA-32 instruction set. 64-bit builds were introduced in the 4.0 release.<sup about="#mwt882" class="mw-ref reference" id="cite_ref-maclinux64_199-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"maclinux64"}}'><a href="#cite_note-maclinux64-199" id="mwBZ0"><span class="mw-reflink-text" id="mwBZ4"><span class="cite-bracket" id="mwBZ8">[</span>199<span class="cite-bracket" id="mwBaA">]</span></span></a></sup> The 46.0 release replaced <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/GTK" title="GTK" id="mwBaE">GTK</a> 2.18 with 3.4 as a system requirement on Linux and other systems running <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/X.Org_Server" title="X.Org Server" id="mwBaI">X.Org</a>.<sup about="#mwt885" class="mw-ref reference" id="cite_ref-211" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-211"}}'><a href="#cite_note-211" id="mwBaM"><span class="mw-reflink-text" id="mwBaQ"><span class="cite-bracket" id="mwBaU">[</span>211<span class="cite-bracket" id="mwBaY">]</span></span></a></sup> Starting with 53.0, the 32-bit builds required the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/SSE2" title="SSE2" id="mwBac">SSE2</a> instruction set.<sup about="#mwt888" class="mw-ref reference" id="cite_ref-212" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-212"}}'><a href="#cite_note-212" id="mwBag"><span class="mw-reflink-text" id="mwBak"><span class="cite-bracket" id="mwBao">[</span>212<span class="cite-bracket" id="mwBas">]</span></span></a></sup></p>

<p id="mwBaw">Firefox 145 dropped support for 32-bit Linux on November 11, 2025, with those users being supported on the Firefox 140 ESR branch until October 13, 2026.<sup about="#mwt891" class="mw-ref reference" id="cite_ref-213" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-213"}}'><a href="#cite_note-213" id="mwBa0"><span class="mw-reflink-text" id="mwBa4"><span class="cite-bracket" id="mwBa8">[</span>213<span class="cite-bracket" id="mwBbA">]</span></span></a></sup> Alternatively, despite not being officially supported, Mozilla continued providing compiled 32-bit builds of the then-legacy ESR 115 branch until version 115.36, released on May 19, 2026.<sup about="#mwt894" class="mw-ref reference" id="cite_ref-214" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-214"}}'><a href="#cite_note-214" id="mwBbE"><span class="mw-reflink-text" id="mwBbI"><span class="cite-bracket" id="mwBbM">[</span>214<span class="cite-bracket" id="mwBbQ">]</span></span></a></sup></p>

</section><section data-mw-section-id="21" id="mwBbU" aria-labelledby="Firefox_for_Android"><div class="mw-heading mw-heading3"><h3 id="Firefox_for_Android">Firefox for Android</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Firefox&amp;action=edit&amp;section=21" title="Edit section: Firefox for Android"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<span class="mw-empty-elt" about="#mwt895" typeof="mw:Transclusion" id="mwBbY" data-mw='{"parts":[{"template":{"target":{"wt":"Main","href":"./Template:Main"},"params":{"1":{"wt":"Firefox for Android"}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1368532237" about="#mwt896" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'/></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt895" id="mwBbc">Main article: <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Firefox_for_Android" title="Firefox for Android">Firefox for Android</a></div>

<p id="mwBbg">Firefox for mobile, code-named "Fennec", was first released for <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Maemo" title="Maemo" id="mwBbk">Maemo</a> in January 2010 with version 1.0<sup about="#mwt899" class="mw-ref reference" id="cite_ref-215" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-215"}}'><a href="#cite_note-215" id="mwBbo"><span class="mw-reflink-text" id="mwBbs"><span class="cite-bracket" id="mwBbw">[</span>215<span class="cite-bracket" id="mwBb0">]</span></span></a></sup> and for <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Android_(operating_system)" title="Android (operating system)" id="mwBb4">Android</a> in March 2011 with version 4.0.<sup about="#mwt902" class="mw-ref reference" id="cite_ref-ff43_216-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"ff43"},"body":{"id":"mw-reference-text-cite_note-ff43-216"}}'><a href="#cite_note-ff43-216" id="mwBb8"><span class="mw-reflink-text" id="mwBcA"><span class="cite-bracket" id="mwBcE">[</span>216<span class="cite-bracket" id="mwBcI">]</span></span></a></sup> Support for Maemo was discontinued after version 7, released in September 2011.<sup about="#mwt905" class="mw-ref reference" id="cite_ref-217" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-217"}}'><a href="#cite_note-217" id="mwBcM"><span class="mw-reflink-text" id="mwBcQ"><span class="cite-bracket" id="mwBcU">[</span>217<span class="cite-bracket" id="mwBcY">]</span></span></a></sup> Fennec had a user interface optimized for phones and tablets. It included the Awesome Bar, tabbed browsing, add-on support, a <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Password_manager" title="Password manager" id="mwBcc">password manager</a>, location-aware browsing, and the ability to synchronize with the user's other devices with Mozilla Firefox using Firefox Sync (formerly Weave).<sup about="#mwt908" class="mw-ref reference" id="cite_ref-218" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-218"}}'><a href="#cite_note-218" id="mwBcg"><span class="mw-reflink-text" id="mwBck"><span class="cite-bracket" id="mwBco">[</span>218<span class="cite-bracket" id="mwBcs">]</span></span></a></sup><sup about="#mwt911" class="mw-ref reference" id="cite_ref-219" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-219"}}'><a href="#cite_note-219" id="mwBcw"><span class="mw-reflink-text" id="mwBc0"><span class="cite-bracket" id="mwBc4">[</span>219<span class="cite-bracket" id="mwBc8">]</span></span></a></sup> At the end of its existence, it had a market share of 0.5% on Android.<sup about="#mwt914" class="mw-ref reference" id="cite_ref-220" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-220"}}'><a href="#cite_note-220" id="mwBdA"><span class="mw-reflink-text" id="mwBdE"><span class="cite-bracket" id="mwBdI">[</span>220<span class="cite-bracket" id="mwBdM">]</span></span></a></sup></p>

<p id="mwBdQ">In August 2020, Mozilla launched a new version of its Firefox for Android app, named Firefox Daylight to the public<sup about="#mwt917" class="mw-ref reference" id="cite_ref-Zare_221-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Zare"},"body":{"id":"mw-reference-text-cite_note-Zare-221"}}'><a href="#cite_note-Zare-221" id="mwBdU"><span class="mw-reflink-text" id="mwBdY"><span class="cite-bracket" id="mwBdc">[</span>221<span class="cite-bracket" id="mwBdg">]</span></span></a></sup> and codenamed <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Firefox_for_Android" title="Firefox for Android" id="mwBdk">Fenix</a>,<sup about="#mwt920" class="mw-ref reference" id="cite_ref-222" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-222"}}'><a href="#cite_note-222" id="mwBdo"><span class="mw-reflink-text" id="mwBds"><span class="cite-bracket" id="mwBdw">[</span>222<span class="cite-bracket" id="mwBd0">]</span></span></a></sup> after a little over a year of testing.<sup about="#mwt923" class="mw-ref reference" id="cite_ref-auto_223-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"auto"},"body":{"id":"mw-reference-text-cite_note-auto-223"}}'><a href="#cite_note-auto-223" id="mwBd4"><span class="mw-reflink-text" id="mwBd8"><span class="cite-bracket" id="mwBeA">[</span>223<span class="cite-bracket" id="mwBeE">]</span></span></a></sup> It boasted higher speeds with its new <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/GeckoView" title="GeckoView" class="mw-redirect" id="mwBeI">GeckoView</a> engine, which is described as being "the only independent <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Browser_engine" title="Browser engine" id="mwBeM">web engine browser</a> available on <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Android_(operating_system)" title="Android (operating system)" id="mwBeQ">Android</a>". It also added Enhanced Tracking Protection 2.0, a feature that blocks many known <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_tracking" title="Internet tracking" class="mw-redirect" id="mwBeU">trackers</a> on the Internet.<sup about="#mwt926" class="mw-ref reference" id="cite_ref-224" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-224"}}'><a href="#cite_note-224" id="mwBeY"><span class="mw-reflink-text" id="mwBec"><span class="cite-bracket" id="mwBeg">[</span>224<span class="cite-bracket" id="mwBek">]</span></span></a></sup> It also added the ability to place the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Address_bar" title="Address bar" id="mwBeo">address bar</a> on the bottom, and a new Collections feature.<sup about="#mwt927" class="mw-ref reference" id="cite_ref-Zare_221-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Zare"}}'><a href="#cite_note-Zare-221" id="mwBes"><span class="mw-reflink-text" id="mwBew"><span class="cite-bracket" id="mwBe0">[</span>221<span class="cite-bracket" id="mwBe4">]</span></span></a></sup> However, it was criticized for only having nine <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Add-ons_for_Firefox" title="Add-ons for Firefox" class="mw-redirect" id="mwBe8">Add-ons</a> at launch, and missing certain features.<sup about="#mwt930" class="mw-ref reference" id="cite_ref-225" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-225"}}'><a href="#cite_note-225" id="mwBfA"><span class="mw-reflink-text" id="mwBfE"><span class="cite-bracket" id="mwBfI">[</span>225<span class="cite-bracket" id="mwBfM">]</span></span></a></sup><sup about="#mwt933" class="mw-ref reference" id="cite_ref-226" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-226"}}'><a href="#cite_note-226" id="mwBfQ"><span class="mw-reflink-text" id="mwBfU"><span class="cite-bracket" id="mwBfY">[</span>226<span class="cite-bracket" id="mwBfc">]</span></span></a></sup><sup about="#mwt936" class="mw-ref reference" id="cite_ref-227" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-227"}}'><a href="#cite_note-227" id="mwBfg"><span class="mw-reflink-text" id="mwBfk"><span class="cite-bracket" id="mwBfo">[</span>227<span class="cite-bracket" id="mwBfs">]</span></span></a></sup> In response, Mozilla stated that they will allow more Add-ons with time.<sup about="#mwt939" class="mw-ref reference" id="cite_ref-228" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-228"}}'><a href="#cite_note-228" id="mwBfw"><span class="mw-reflink-text" id="mwBf0"><span class="cite-bracket" id="mwBf4">[</span>228<span class="cite-bracket" id="mwBf8">]</span></span></a></sup></p>

<ul class="gallery mw-gallery-packed" typeof="mw:Extension/gallery" about="#mwt940" id="mwBgA" data-mw='{"name":"gallery","attrs":{"mode":"packed","heights":"200"},"body":{}}'>
<li class="gallerybox" style="width: 360px;" id="mwBgE"><div class="thumb" style="width: 358px;" id="mwBgI"><span typeof="mw:File" id="mwBgM"><a href="https://en.wikipedia.org/wiki/File:FennecMeeGo_(cropped).png" class="mw-file-description" title="Firefox on MeeGo OS" id="mwBgQ"><img resource="https://en.wikipedia.org/wiki/File:FennecMeeGo_(cropped).png" src="//upload.wikimedia.org/wikipedia/commons/a/a1/FennecMeeGo_%28cropped%29.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled" decoding="async" loading="lazy" alt="Firefox on MeeGo OS" data-file-width="869" data-file-height="486" data-file-type="bitmap" height="200" width="358" class="mw-file-element" id="mwBgU"/></a></span></div><div class="gallerytext" id="mwBgY"> Firefox on <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/MeeGo" title="MeeGo" id="mwBgc">MeeGo</a> OS</div></li>
<li class="gallerybox" style="width: 135.33333333333px;" id="mwBgg"><div class="thumb" style="width: 133.33333333333px;" id="mwBgk"><span typeof="mw:File" id="mwBgo"><a href="https://en.wikipedia.org/wiki/File:Firefox_in_firefox_os.png" class="mw-file-description" title="Firefox on Firefox OS" id="mwBgs"><img resource="https://en.wikipedia.org/wiki/File:Firefox_in_firefox_os.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/f/fc/Firefox_in_firefox_os.png/250px-Firefox_in_firefox_os.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//upload.wikimedia.org/wikipedia/commons/f/fc/Firefox_in_firefox_os.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x" alt="Firefox on Firefox OS" data-file-width="320" data-file-height="480" data-file-type="bitmap" height="200" width="134" class="mw-file-element" id="mwBgw"/></a></span></div><div class="gallerytext" id="mwBg0"> Firefox on <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Firefox_OS" title="Firefox OS" id="mwBg4">Firefox OS</a></div></li>
<li class="gallerybox" style="width: 92px;" id="mwBg8"><div class="thumb" style="width: 90px;" id="mwBhA"><span typeof="mw:File" id="mwBhE"><a href="https://en.wikipedia.org/wiki/File:Firefox_for_Android_145.0_screenshot.webp" class="mw-file-description" title="Firefox 145 on Android" id="mwBhI"><img resource="https://en.wikipedia.org/wiki/File:Firefox_for_Android_145.0_screenshot.webp" src="//thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/Firefox_for_Android_145.0_screenshot.webp/250px-Firefox_for_Android_145.0_screenshot.webp?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/Firefox_for_Android_145.0_screenshot.webp/330px-Firefox_for_Android_145.0_screenshot.webp?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="Firefox 145 on Android" data-file-width="720" data-file-height="1600" data-file-type="bitmap" height="200" width="90" class="mw-file-element" id="mwBhM"/></a></span></div><div class="gallerytext" id="mwBhQ"> Firefox 145 on <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Android_(operating_system)" title="Android (operating system)" id="mwBhU">Android</a></div></li>
</ul>

<span class="mw-empty-elt" about="#mwt941" typeof="mw:Transclusion" id="mwBhY" data-mw='{"parts":[{"template":{"target":{"wt":"Firefox for Android release compatibility","href":"./Template:Firefox_for_Android_release_compatibility"},"params":{},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1374427404" about="#mwt942" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Hlist/styles.css"},"body":{"extsrc":""}}'/><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1239400231" about="#mwt943" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Navbar/styles.css"},"body":{"extsrc":""}}'/></span><div class="navbar plainlinks hlist" about="#mwt941"><ul><li class="nv-view"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Template:Firefox_for_Android_release_compatibility" title="Template:Firefox for Android release compatibility"><span title="View this template">view</span></a></li><li class="nv-talk"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Template_talk:Firefox_for_Android_release_compatibility" title="Template talk:Firefox for Android release compatibility"><span title="Discuss this template">talk</span></a></li><li class="nv-edit"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:EditPage/Template:Firefox_for_Android_release_compatibility" title="Special:EditPage/Template:Firefox for Android release compatibility"><span title="Edit this template">edit</span></a></li></ul></div><table class="wikitable sortable" style="text-align:center; margin-top: 0px;" about="#mwt941">
<tbody><tr><th colspan="2"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Operating_system" title="Operating system">Operating system</a></th>
<th>Latest stable version</th>
<th>Support status</th></tr>
<tr>
<td rowspan="19"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Android_(operating_system)" title="Android (operating system)">Android</a> <br/>(including <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Android-x86" title="Android-x86">Android-x86</a> and <br/><a rel="mw:ExtLink nofollow" href="https://github.com/androidarmv6/android" class="external text">Android for ARMv6</a>)</td>
