<li class="gallerybox" style="width: 145px;" id="mwCC4"><div class="thumb" style="width: 140px; height: 140px;" id="mwCC8"><span typeof="mw:File" id="mwCDA"><a href="https://en.wikipedia.org/wiki/File:Firefox_Developer_Edition_logo,2019.svg" class="mw-file-description" title="The 2019 Developer Edition logo" id="mwCDE"><img resource="https://en.wikipedia.org/wiki/File:Firefox_Developer_Edition_logo,2019.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/3/30/Firefox_Developer_Edition_logo%2C_2019.svg/120px-Firefox_Developer_Edition_logo%2C_2019.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/3/30/Firefox_Developer_Edition_logo%2C_2019.svg/250px-Firefox_Developer_Edition_logo%2C_2019.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="The 2019 Developer Edition logo" data-file-width="78" data-file-height="80" data-file-type="drawing" height="110" width="107" class="mw-file-element" id="mwCDI"/></a></span></div><div class="gallerytext" id="mwCDM">The 2019 Developer Edition logo</div></li>
</ul>

<ul class="gallery mw-gallery-traditional" style="text-align:center;margin:0 auto" typeof="mw:Extension/gallery" about="#mwt1244" id="mwCDQ" data-mw='{"name":"gallery","attrs":{"style":"text-align:center;margin:0 auto","heights":"110","widths":"110"},"body":{}}'>
