<li about="#cite_note-No_longer_supported-13" id="cite_note-No_longer_supported-13" data-mw-footnote-number="13"><span class="mw-cite-backlink" id="mwAYc"><a href="#cite_ref-No_longer_supported_13-0" rel="mw:referencedBy" id="mwAYg"><span class="mw-linkback-text" id="mwAYk">↑</span></a></span> <span id="mw-reference-text-cite_note-No_longer_supported-13" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt52" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwAYo" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://source.android.com/security/bulletin/2017-10-01"},"title":{"wt":"Android Security Bulletin—October 2017 {{!}} Android Open Source Project"},"website":{"wt":"Android Open Source Project"},"language":{"wt":"en"},"access-date":{"wt":"2018-07-02"},"archive-date":{"wt":"July 5, 2018"},"archive-url":{"wt":"https://web.archive.org/web/20180705150626/https://source.android.com/security/bulletin/2017-10-01"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt52" id="mwAYs"><a rel="mw:ExtLink nofollow" href="https://source.android.com/security/bulletin/2017-10-01" class="external text" id="mwAYw">"Android Security Bulletin—October 2017 | Android Open Source Project"</a>. <i id="mwAY0">Android Open Source Project</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20180705150626/https://source.android.com/security/bulletin/2017-10-01" class="external text" id="mwAY4">Archived</a> from the original on July 5, 2018<span class="reference-accessdate" id="mwAY8">. Retrieved <span class="nowrap" id="mwAZA">July 2,</span> 2018</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Android+Open+Source+Project&amp;rft.atitle=Android+Security+Bulletin%E2%80%94October+2017+%7C+Android+Open+Source+Project&amp;rft_id=https%3A%2F%2Fsource.android.com%2Fsecurity%2Fbulletin%2F2017-10-01&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAndroid+KitKat" class="Z3988" about="#mwt52" id="mwAZE"></span></span></li>
<li about="#cite_note-AndroidSecurityOverview-14" id="cite_note-AndroidSecurityOverview-14" data-mw-footnote-number="14"><span class="mw-cite-backlink" id="mwAZI"><a href="#cite_ref-AndroidSecurityOverview_14-0" rel="mw:referencedBy" id="mwAZM"><span class="mw-linkback-text" id="mwAZQ">↑</span></a></span> <span id="mw-reference-text-cite_note-AndroidSecurityOverview-14" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt55" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwAZU" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web","href":"./Template:Cite_web"},"params":{"title":{"wt":"Security updates and resources"},"url":{"wt":"https://source.android.com/security/overview/updates-resources.html"},"quote":{"wt":"When a security vulnerability in AOSP is fixed in an Android Security Bulletin, we&apos;ll notify Android partners of issue details and provide patches. The Android security team currently provides patches for Android versions 4.4 (KitKat) and above. This list of backport-supported versions changes with each new Android release."},"website":{"wt":"Android.com"},"publisher":{"wt":"Android Open Source Project"},"access-date":{"wt":"September 10, 2017"},"archive-date":{"wt":"January 12, 2017"},"archive-url":{"wt":"https://web.archive.org/web/20170112142654/https://source.android.com/security/overview/updates-resources.html"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt55" id="mwAZY"><a rel="mw:ExtLink nofollow" href="https://source.android.com/security/overview/updates-resources.html" class="external text" id="mwAZc">"Security updates and resources"</a>. <i id="mwAZg">Android.com</i>. Android Open Source Project. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20170112142654/https://source.android.com/security/overview/updates-resources.html" class="external text" id="mwAZk">Archived</a> from the original on January 12, 2017<span class="reference-accessdate" id="mwAZo">. Retrieved <span class="nowrap" id="mwAZs">September 10,</span> 2017</span>. <q id="mwAZw">When a security vulnerability in AOSP is fixed in an Android Security Bulletin, we'll notify Android partners of issue details and provide patches. The Android security team currently provides patches for Android versions 4.4 (KitKat) and above. This list of backport-supported versions changes with each new Android release.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Android.com&amp;rft.atitle=Security+updates+and+resources&amp;rft_id=https%3A%2F%2Fsource.android.com%2Fsecurity%2Foverview%2Fupdates-resources.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAndroid+KitKat" class="Z3988" about="#mwt55" id="mwAZ0"></span></span></li>
