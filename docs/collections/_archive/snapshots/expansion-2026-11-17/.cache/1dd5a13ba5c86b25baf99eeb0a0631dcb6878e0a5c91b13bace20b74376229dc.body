<div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt7" typeof="mw:Transclusion" id="mwDA" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox OS version\n","href":"./Template:Infobox_OS_version"},"params":{"name":{"wt":"iPhone OS 3"},"version of":{"wt":"[[iOS]]"},"logo":{"wt":"IPhone OS 3 logo.png"},"logo_size":{"wt":"85px"},"screenshot":{"wt":"File:IPhone_OS_3_iPhone_3GS.png"},"screenshot_size":{"wt":"258px&lt;!--Native resolution-->"},"caption":{"wt":"iPhone OS 3.1 home screen on an [[iPhone 3GS]]"},"developer":{"wt":"[[Apple Inc.]]"},"working state":{"wt":"No longer supported"},"website":{"wt":"{{webarchive |url=https://web.archive.org/web/20090818022633/http://www.apple.com/iphone/softwareupdate/ |date=August 18, 2009 |title=Apple - iPhone - New features in the iPhone 3.0 Software Update }}"},"source_model":{"wt":"[[Closed source|Closed]], with [[open-source software|open source]] components &lt;!-- See Darwin Unix wiki page for complete source model explanation -->"},"license":{"wt":"[[Proprietary software]] except for open-source components"},"kernel_type":{"wt":"[[Hybrid kernel|Hybrid]] ([[XNU]])"},"released":{"wt":"{{Start date and age|2009|06|17}}"},"release_version":{"wt":"3.2.2 (7B500)"},"release_date":{"wt":"{{start date and age|2010|08|11}}"},"release_url":{"wt":""},"preceded_by":{"wt":"[[iPhone OS 2]]"},"succeeded_by":{"wt":"[[iOS 4]]"},"preview_version":{"wt":""},"preview_date":{"wt":""},"preview_url":{"wt":""},"sales":{"wt":""},"update_model":{"wt":"[[iTunes]] through a computer"},"package_manager":{"wt":"[[App Store]]"},"support_status":{"wt":"Obsolete, unsupported&lt;ref>{{cite web | title=IOS 3.1.3 Users Are No Longer Able to Use Mobile App Store? | date=December 20, 2011 | url=https://www.iclarified.com/18895/ios-313-users-are-no-longer-able-to-use-mobile-app-store | access-date=May 24, 2025 | archive-date=May 24, 2025 | archive-url=https://web.archive.org/web/20250524181057/https://www.iclarified.com/18895/ios-313-users-are-no-longer-able-to-use-mobile-app-store | url-status=live }}&lt;/ref>"},"supported_platforms":{"wt":"[[iPhone]], [[iPod Touch]], [[iPad]]"},"other_articles":{"wt":""}},"i":0}}]}'>Operating system</div><span class="mw-empty-elt" about="#mwt7"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_is_different_from_Wikidata"/><style data-mw-deduplicate="TemplateStyles:r1385617415" typeof="mw:Extension/templatestyles" about="#mwt8" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobox-hiddenrow,body.skin--responsive.skin--responsive .mw-parser-output .infobox .infobox-hiddenrow{display:none}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:var(--color-base)}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:var(--color-base)}}@media(min-width:640px){body.skin--responsive .mw-parser-output .infobox-table{display:table!important}body.skin--responsive .mw-parser-output .infobox-table>caption{display:table-caption!important}body.skin--responsive .mw-parser-output .infobox-table>tbody{display:table-row-group}body.skin--responsive .mw-parser-output .infobox-table th,body.skin--responsive .mw-parser-output .infobox-table td{padding-left:inherit;padding-right:inherit}}</style></span><table class="infobox vevent" about="#mwt7" id="mwDQ"><tbody><tr><th colspan="2" class="infobox-above" style="background-color: #e0e0e0; color: inherit;">iPhone OS 3</th></tr><tr><td colspan="2" class="infobox-subheader">Version of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IOS" title="IOS">iOS</a> operating system</td></tr><tr><td colspan="2" class="infobox-image"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:IPhone_OS_3_logo.png" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:IPhone_OS_3_logo.png" src="//thumb.wikimedia.org/wikipedia/commons/thumb/b/be/IPhone_OS_3_logo.png/120px-IPhone_OS_3_logo.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//upload.wikimedia.org/wikipedia/commons/b/be/IPhone_OS_3_logo.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x" data-file-width="237" data-file-height="240" data-file-type="bitmap" height="86" width="85" class="mw-file-element"/></a></span></td></tr><tr><td colspan="2" class="infobox-image"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:IPhone_OS_3_iPhone_3GS.png" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:IPhone_OS_3_iPhone_3GS.png" src="//upload.wikimedia.org/wikipedia/en/5/5d/IPhone_OS_3_iPhone_3GS.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled" decoding="async" loading="lazy" data-file-width="258" data-file-height="387" data-file-type="bitmap" height="387" width="258" class="mw-file-element"/></a></span><div class="infobox-caption">iPhone OS 3.1 home screen on an <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPhone_3GS" title="IPhone 3GS">iPhone 3GS</a></div></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Programmer" title="Programmer">Developer</a></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Apple_Inc." title="Apple Inc.">Apple Inc.</a></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Working state</th><td class="infobox-data">No longer supported</td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Source model</th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Closed_source" title="Closed source" class="mw-redirect">Closed</a>, with <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Open-source_software" title="Open-source software">open source</a> components</td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Initial release</th><td class="infobox-data">June<span typeof="mw:Entity"> </span>17, 2009<span class="noprint"><span typeof="mw:Entity">;</span><span typeof="mw:Entity"> </span>17 years ago</span><span style="display:none"><span typeof="mw:Entity"> </span>(<span class="bday dtstart published updated">2009-06-17</span>)</span></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Software_release_life_cycle" title="Software release life cycle">Latest release</a></th><td class="infobox-data">3.2.2 (7B500) / August<span typeof="mw:Entity"> </span>11, 2010<span class="noprint"><span typeof="mw:Entity">;</span><span typeof="mw:Entity"> </span>16 years ago</span><span style="display:none"><span typeof="mw:Entity"> </span>(<span class="bday dtstart published updated">2010-08-11</span>)</span></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Update method</th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ITunes" title="ITunes">iTunes</a> through a computer</td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Package_manager" title="Package manager">Package manager</a></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/App_Store" title="App Store" class="mw-redirect">App Store</a></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Supported platforms</th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPhone" title="IPhone">iPhone</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPod_Touch" title="IPod Touch">iPod Touch</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPad" title="IPad">iPad</a></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Kernel_(operating_system)" title="Kernel (operating system)">Kernel</a> type</th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Hybrid_kernel" title="Hybrid kernel">Hybrid</a> (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/XNU" title="XNU">XNU</a>)</td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Software_license" title="Software license">License</a></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Proprietary_software" title="Proprietary software">Proprietary software</a> except for open-source components</td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Preceded by</th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPhone_OS_2" title="IPhone OS 2">iPhone OS 2</a></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Succeeded by</th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IOS_4" title="IOS 4">iOS 4</a></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Official website</th><td class="infobox-data"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20090818022633/http://www.apple.com/iphone/softwareupdate/" class="external text">Apple - iPhone - New features in the iPhone 3.0 Software Update</a> at the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wayback_Machine" title="Wayback Machine">Wayback Machine</a><span typeof="mw:Entity"> </span>(archived August 18, 2009)<link rel="mw:PageProp/Category" href="./Category:Webarchive_template_wayback_links"/></td></tr><tr><th colspan="2" class="infobox-header">Support status</th></tr><tr><td colspan="2" class="infobox-full-data">Obsolete, unsupported<sup about="#mwt11" class="mw-ref reference" id="cite_ref-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-1"}}'><a href="#cite_note-1" id="mwDg"><span class="mw-reflink-text" id="mwDw"><span class="cite-bracket" id="mwEA">[</span>1<span class="cite-bracket" id="mwEQ">]</span></span></a></sup></td></tr></tbody></table>

<p id="mwEg"><b id="mwEw">iPhone OS 3</b> (<i id="mwFA">stylized as <b id="mwFQ">iPhone OS 3.0</b></i>) is the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IOS_version_history#iPhone_OS_3" title="IOS version history" id="mwFg">third major release</a> of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IOS" title="IOS" id="mwFw">iOS</a> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mobile_operating_system" title="Mobile operating system" id="mwGA">mobile operating system</a> developed by <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Apple_Inc." title="Apple Inc." id="mwGQ">Apple Inc.</a>, succeeding <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPhone_OS_2" title="IPhone OS 2" id="mwGg">iPhone OS 2</a>. It was announced on March 17, 2009, and was released on June 17, 2009. It was succeeded by <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IOS_4" title="IOS 4" id="mwGw">iOS 4</a> on June 21, 2010, dropping the "iPhone OS" naming convention.<sup about="#mwt16" class="mw-ref reference" id="cite_ref-2" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-2"}}'><a href="#cite_note-2" id="mwHA"><span class="mw-reflink-text" id="mwHQ"><span class="cite-bracket" id="mwHg">[</span>2<span class="cite-bracket" id="mwHw">]</span></span></a></sup></p>

<p id="mwIA">iPhone OS 3 added a system-wide "cut, copy, and paste" feature, allowing users to move content more easily. It also introduced <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Spotlight_(software)" title="Spotlight (software)" class="mw-redirect" id="mwIQ">Spotlight</a>, a search indexing feature designed to help users locate specific information on their device, such as contacts, email messages, or apps. The home screen was expanded to let users add up to 11 pages, showcasing a total of 180 apps. The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Messages_(Apple)" title="Messages (Apple)" id="mwIg">Messages</a> app received support for <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Multimedia_Messaging_Service" title="Multimedia Messaging Service" id="mwIw">MMS</a>, the Camera app received video recording support on the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPhone_3GS" title="IPhone 3GS" id="mwJA">iPhone 3GS</a>, and a new "Voice Memos" app let users record their voice. In-app purchase capability was added to third-party applications in the App Store as well. Apple also added the accessibility screen reader option <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/VoiceOver" title="VoiceOver" id="mwJQ">VoiceOver</a> to iOS devices with this release.<sup about="#mwt19" class="mw-ref reference" id="cite_ref-3" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-3"}}'><a href="#cite_note-3" id="mwJg"><span class="mw-reflink-text" id="mwJw"><span class="cite-bracket" id="mwKA">[</span>3<span class="cite-bracket" id="mwKQ">]</span></span></a></sup></p>

<p id="mwKg">iPhone OS 3 is the last version of iOS that supports the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPhone_(1st_generation)" title="IPhone (1st generation)" id="mwKw">first-generation iPhone</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPod_Touch_(1st_generation)" title="IPod Touch (1st generation)" id="mwLA">first-generation iPod Touch</a> as its successor, iOS 4, drops support for both models.</p>

<p id="mwLQ">iPhone OS 3.2 is the first <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IOS" title="IOS" id="mwLg">iPhone OS</a> version to support the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPad_(1st_generation)" title="IPad (1st generation)" id="mwLw">first generation iPad</a>.</p>

<meta property="mw:PageProp/toc" id="mwMA" data-mw='{"autoGenerated":true}'/></section><section data-mw-section-id="1" id="mwMQ" aria-labelledby="Default_apps"><div class="mw-heading mw-heading2"><h2 id="Default_apps">Default apps</h2></div>

<ul id="mwMg"><li id="mwMw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ITunes_Store" title="ITunes Store" id="mwNA">iTunes</a></li>
<li id="mwNQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/App_Store_(iOS)" title="App Store (iOS)" class="mw-redirect" id="mwNg">App Store</a></li>
<li id="mwNw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Text_(iOS)" title="Text (iOS)" class="mw-redirect" id="mwOA">Text</a></li>
<li id="mwOQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Calendar_(Apple)" title="Calendar (Apple)" id="mwOg">Calendar</a></li>
<li id="mwOw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Photos_(Apple)" title="Photos (Apple)" id="mwPA">Photos</a></li>
<li id="mwPQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Camera" title="Camera" id="mwPg">Camera</a></li>
<li id="mwPw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/YouTube" title="YouTube" id="mwQA">YouTube</a></li>
<li id="mwQQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Yahoo!_Finance" title="Yahoo! Finance" class="mw-redirect" id="mwQg">Stocks</a></li>
<li id="mwQw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Google_Maps" title="Google Maps" id="mwRA">Maps</a></li>
<li id="mwRQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Weather_(Apple)" title="Weather (Apple)" id="mwRg">Weather</a></li>
<li id="mwRw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Clock_(software)" title="Clock (software)" class="mw-redirect" id="mwSA">Clock</a></li>
<li id="mwSQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Calculator_(macOS)" title="Calculator (macOS)" class="mw-redirect" id="mwSg">Calculator</a></li>
<li id="mwSw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Notes_(Apple)" title="Notes (Apple)" id="mwTA">Notes</a></li>
<li id="mwTQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Computer_configuration" title="Computer configuration" id="mwTg">Settings</a></li></ul>

<section data-mw-section-id="2" id="mwTw" aria-labelledby="Default_dock"><div class="mw-heading mw-heading3"><h3 id="Default_dock">Default dock</h3></div>
<ul id="mwUA"><li id="mwUQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Phone" title="Phone" class="mw-redirect" id="mwUg">Phone</a></li>
<li id="mwUw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mail_(Apple)" title="Mail (Apple)" class="mw-redirect" id="mwVA">Mail</a></li>
<li id="mwVQ"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Safari_(web_browser)" title="Safari (web browser)" id="mwVg">Safari</a></li>
<li id="mwVw"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPod_(app)" title="IPod (app)" class="mw-redirect" id="mwWA">iPod/Music</a></li></ul>

</section></section><section data-mw-section-id="3" id="mwWQ" aria-labelledby="System_features"><div class="mw-heading mw-heading2"><h2 id="System_features">System features</h2></div>

<figure class="mw-default-size mw-halign-right" typeof="mw:File/Thumb" id="mwWg"><a href="https://en.wikipedia.org/wiki/File:IPhone_OS_3_iPad.png" class="mw-file-description" id="mwWw"><img resource="https://en.wikipedia.org/wiki/File:IPhone_OS_3_iPad.png" src="//thumb.wikimedia.org/wikipedia/en/thumb/a/a8/IPhone_OS_3_iPad.png/250px-IPhone_OS_3_iPad.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//upload.wikimedia.org/wikipedia/en/a/a8/IPhone_OS_3_iPad.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x" data-file-width="365" data-file-height="274" data-file-type="bitmap" height="188" width="250" class="mw-file-element" id="mwXA"/></a><figcaption id="mwXQ">iPhone OS 3.2 on an <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPad_(1st_generation)" title="IPad (1st generation)" id="mwXg">original iPad</a></figcaption></figure>

<section data-mw-section-id="4" id="mwXw" aria-labelledby="Cut,_copy,_or_paste"><div class="mw-heading mw-heading3"><h3 id="Cut,_copy,_or_paste"><span id="Cut.2C_copy.2C_or_paste" typeof="mw:FallbackId"></span>Cut, copy, or paste</h3></div>
<p id="mwYA">iPhone OS 3 introduced a "cut, copy, and paste" bubble dialog when users press and hold text. The "paste" button would incorporate anything stored in the device's clipboard into the marked area.<sup about="#mwt22" class="mw-ref reference" id="cite_ref-Macworld_features_4-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Macworld features"},"body":{"id":"mw-reference-text-cite_note-Macworld_features-4"}}'><a href="#cite_note-Macworld_features-4" id="mwYQ"><span class="mw-reflink-text" id="mwYg"><span class="cite-bracket" id="mwYw">[</span>4<span class="cite-bracket" id="mwZA">]</span></span></a></sup><sup about="#mwt25" class="mw-ref reference" id="cite_ref-5" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-5"}}'><a href="#cite_note-5" id="mwZQ"><span class="mw-reflink-text" id="mwZg"><span class="cite-bracket" id="mwZw">[</span>5<span class="cite-bracket" id="mwaA">]</span></span></a></sup><sup about="#mwt28" class="mw-ref reference" id="cite_ref-6" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-6"}}'><a href="#cite_note-6" id="mwaQ"><span class="mw-reflink-text" id="mwag"><span class="cite-bracket" id="mwaw">[</span>6<span class="cite-bracket" id="mwbA">]</span></span></a></sup></p>

</section><section data-mw-section-id="5" id="mwbQ" aria-labelledby="Spotlight"><div class="mw-heading mw-heading3"><h3 id="Spotlight">Spotlight</h3></div>
<p id="mwbg"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Spotlight_(software)" title="Spotlight (software)" class="mw-redirect" id="mwbw">Spotlight</a> is a system-wide indexing and search feature that helps users search their device for specific contacts, email messages, calendar appointments, multimedia files, apps, and more. It is accessed by swiping to the right from the home screen.<sup about="#mwt31" class="mw-ref reference" id="cite_ref-7" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-7"}}'><a href="#cite_note-7" id="mwcA"><span class="mw-reflink-text" id="mwcQ"><span class="cite-bracket" id="mwcg">[</span>7<span class="cite-bracket" id="mwcw">]</span></span></a></sup></p>

</section><section data-mw-section-id="6" id="mwdA" aria-labelledby="VoiceOver"><div class="mw-heading mw-heading3"><h3 id="VoiceOver">VoiceOver</h3></div>
<p id="mwdQ">VoiceOver is a screen reader accessibility feature for blind or low-vision users that reads the text on the screen. This feature was first introduced with <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mac_OS_X_Tiger" title="Mac OS X Tiger" id="mwdg">OS X 10.4 Tiger</a> in 2005.</p>

</section><section data-mw-section-id="7" id="mwdw" aria-labelledby="Home_screen"><div class="mw-heading mw-heading3"><h3 id="Home_screen">Home screen</h3></div>
<p id="mweA">iPhone OS 3 increased the maximum number of home screen pages to 11, for a total of 180 apps.<sup about="#mwt32" class="mw-ref reference" id="cite_ref-iMore_review_8-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"iMore review"}}'><a href="#cite_note-iMore_review-8" id="mweQ"><span class="mw-reflink-text" id="mweg"><span class="cite-bracket" id="mwew">[</span>8<span class="cite-bracket" id="mwfA">]</span></span></a></sup></p>

</section><section data-mw-section-id="8" id="mwfQ" aria-labelledby="Find_My_iPhone"><div class="mw-heading mw-heading3"><h3 id="Find_My_iPhone">Find My iPhone</h3></div>
<p id="mwfg">Users with <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/MobileMe" title="MobileMe" id="mwfw">MobileMe</a> subscriptions could remotely track, lock, and erase their iPhones if they were lost.</p>

</section></section><section data-mw-section-id="9" id="mwgA" aria-labelledby="App_features"><div class="mw-heading mw-heading2"><h2 id="App_features">App features</h2></div>

<section data-mw-section-id="10" id="mwgQ" aria-labelledby="Messages"><div class="mw-heading mw-heading3"><h3 id="Messages">Messages</h3></div>
<p id="mwgg">The <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Messages_(Apple)" title="Messages (Apple)" id="mwgw">Messages</a> app received native support for the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Multimedia_Messaging_Service" title="Multimedia Messaging Service" id="mwhA">Multimedia Messaging Service</a> (MMS), allowing users to send and receive messages that include pictures, contacts, locations, voice recordings, and video.<sup about="#mwt35" class="mw-ref reference" id="cite_ref-9" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-9"}}'><a href="#cite_note-9" id="mwhQ"><span class="mw-reflink-text" id="mwhg"><span class="cite-bracket" id="mwhw">[</span>9<span class="cite-bracket" id="mwiA">]</span></span></a></sup><sup about="#mwt36" class="mw-ref reference" id="cite_ref-Macworld_features_4-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Macworld features"}}'><a href="#cite_note-Macworld_features-4" id="mwiQ"><span class="mw-reflink-text" id="mwig"><span class="cite-bracket" id="mwiw">[</span>4<span class="cite-bracket" id="mwjA">]</span></span></a></sup></p>

</section><section data-mw-section-id="11" id="mwjQ" aria-labelledby="Camera_and_Photos"><div class="mw-heading mw-heading3"><h3 id="Camera_and_Photos">Camera and Photos</h3></div>
<p id="mwjg">The Camera app introduced video recording for the iPhone 3GS.<sup about="#mwt39" class="mw-ref reference" id="cite_ref-10" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-10"}}'><a href="#cite_note-10" id="mwjw"><span class="mw-reflink-text" id="mwkA"><span class="cite-bracket" id="mwkQ">[</span>10<span class="cite-bracket" id="mwkg">]</span></span></a></sup><sup about="#mwt42" class="mw-ref reference" id="cite_ref-iMore_review_8-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"iMore review"},"body":{"id":"mw-reference-text-cite_note-iMore_review-8"}}'><a href="#cite_note-iMore_review-8" id="mwkw"><span class="mw-reflink-text" id="mwlA"><span class="cite-bracket" id="mwlQ">[</span>8<span class="cite-bracket" id="mwlg">]</span></span></a></sup></p>

<p id="mwlw">The Photos app featured a new copy button and the ability to delete multiple photos at once.<sup about="#mwt43" class="mw-ref reference" id="cite_ref-iMore_review_8-2" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"iMore review"}}'><a href="#cite_note-iMore_review-8" id="mwmA"><span class="mw-reflink-text" id="mwmQ"><span class="cite-bracket" id="mwmg">[</span>8<span class="cite-bracket" id="mwmw">]</span></span></a></sup></p>

</section></section><section data-mw-section-id="12" id="mwnA" aria-labelledby="Cost"><div class="mw-heading mw-heading2"><h2 id="Cost">Cost</h2></div>
<p id="mwnQ">Upgrading to iPhone OS 3 was free for iPhone users. Upgrading to iPhone OS 3 originally cost iPod Touch users $9.95;<sup about="#mwt46" class="mw-ref reference" id="cite_ref-11" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-11"}}'><a href="#cite_note-11" id="mwng"><span class="mw-reflink-text" id="mwnw"><span class="cite-bracket" id="mwoA">[</span>11<span class="cite-bracket" id="mwoQ">]</span></span></a></sup> updating to 3.1.x from 2.x cost only $4.95.<sup about="#mwt49" class="mw-ref reference" id="cite_ref-12" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-12"}}'><a href="#cite_note-12" id="mwog"><span class="mw-reflink-text" id="mwow"><span class="cite-bracket" id="mwpA">[</span>12<span class="cite-bracket" id="mwpQ">]</span></span></a></sup><sup about="#mwt52" class="mw-ref reference" id="cite_ref-13" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-13"}}'><a href="#cite_note-13" id="mwpg"><span class="mw-reflink-text" id="mwpw"><span class="cite-bracket" id="mwqA">[</span>13<span class="cite-bracket" id="mwqQ">]</span></span></a></sup></p>

<p id="mwqg">iPhone OS 3 was the last major version of iOS for which <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPod_Touch" title="IPod Touch" id="mwqw">iPod Touch</a> users had to pay to upgrade. Starting with iOS 4, iOS upgrades became free for all users, including users of the iPod Touch, as the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Sarbanes–Oxley_Act" title="Sarbanes–Oxley Act" id="mwrA">Sarbanes–Oxley Act</a> was revised to allow software upgrades for free with hardware that is not subscription-based.<sup about="#mwt55" class="mw-ref reference" id="cite_ref-14" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-14"}}'><a href="#cite_note-14" id="mwrQ"><span class="mw-reflink-text" id="mwrg"><span class="cite-bracket" id="mwrw">[</span>14<span class="cite-bracket" id="mwsA">]</span></span></a></sup></p>

</section><section data-mw-section-id="13" id="mwsQ" aria-labelledby="Supported_devices"><div class="mw-heading mw-heading2"><h2 id="Supported_devices">Supported devices</h2></div>
<p id="mwsg">All devices that supported iPhone OS 1 and 2 support iPhone OS 3; however, only the iPhone 3GS supports video recording.</p>
<span class="mw-empty-elt" about="#mwt56" typeof="mw:Transclusion" id="mwsw" data-mw='{"parts":[{"template":{"target":{"wt":"col-begin","href":"./Template:Col-begin"},"params":{"width":{"wt":"75%"}},"i":0}},"\n",{"template":{"target":{"wt":"col-break","href":"./Template:Col-break"},"params":{},"i":1}},"\n\n===iPhone===\n*[[iPhone (1st generation)]]\n*[[iPhone 3G]]\n*[[iPhone 3GS]]\n\n",{"template":{"target":{"wt":"col-break","href":"./Template:Col-break"},"params":{},"i":2}},"\n\n===iPod Touch===\n*[[iPod Touch (1st generation)]]\n*[[iPod Touch (2nd generation)]]\n*[[iPod Touch (3rd generation)]]\n\n",{"template":{"target":{"wt":"col-break","href":"./Template:Col-break"},"params":{},"i":3}},"\n\n===iPad===\n*[[iPad (1st generation)]]\n",{"template":{"target":{"wt":"col-end","href":"./Template:Col-end"},"params":{},"i":4}}]}'><style data-mw-deduplicate="TemplateStyles:r1216972533" typeof="mw:Extension/templatestyles" about="#mwt57" data-mw='{"name":"templatestyles","attrs":{"src":"Col-begin/styles.css"}}'>.mw-parser-output .col-begin{border-collapse:collapse;padding:0;color:inherit;width:100%;border:0;margin:0}.mw-parser-output .col-begin-small{font-size:90%}.mw-parser-output .col-break{vertical-align:top;text-align:left}.mw-parser-output .col-break-2{width:50%}.mw-parser-output .col-break-3{width:33.3%}.mw-parser-output .col-break-4{width:25%}.mw-parser-output .col-break-5{width:20%}@media(max-width:720px){.mw-parser-output .col-begin,.mw-parser-output .col-begin>tbody,.mw-parser-output .col-begin>tbody>tr,.mw-parser-output .col-begin>tbody>tr>td{display:block!important;width:100%!important}.mw-parser-output .col-break{padding-left:0!important}}</style></span><div about="#mwt56" id="mwtA">
<table class=" col-begin " role="presentation" style="width: 75%;">

<tbody>
<tr><td class="col-break ">

<section data-mw-section-id="-1" id="mwtQ" aria-labelledby="iPhone"><div class="mw-heading mw-heading3"><h3 id="iPhone">iPhone</h3></div>
<ul><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPhone_(1st_generation)" title="IPhone (1st generation)">iPhone (1st generation)</a></li>
