function mouseCoords(ev)
{
	return {
x:ev.clientX + document.body.scrollLeft - document.body.clientLeft,
	  y:ev.clientY + document.body.scrollTop  - document.body.clientTop
	};
}

//获取元素的纵坐标
function getTop(e){
	var offset=e.offsetTop;
	if(e.offsetParent!=null) offset+=getTop(e.offsetParent);
	return offset;
}
//获取元素的横坐标
function getLeft(e){
	var offset=e.offsetLeft;
	if(e.offsetParent!=null) offset+=getLeft(e.offsetParent);
	return offset;
}

function m_ws03(evt) {
	evt=evt?evt:window.event;
	var srcElem=(evt.target)?evt.target:evt.srcElement;
	var aimElem= srcElem;
	try{
		var is_link = false;
		var linkname = "";
		var address = "";
		var valid = false;
		while(srcElem.tagName.toUpperCase()=="A" || srcElem.tagName.toUpperCase()=="INPUT" || srcElem.tagName.toUpperCase()=="IMG") {
			valid = true;
			if(srcElem.tagName.toUpperCase()=="A" || srcElem.tagName.toUpperCase()=="INPUT") {
				is_link = true;
				linkname=srcElem.innerHTML?srcElem.innerHTML:srcElem.value;
				address=srcElem.href?srcElem.href:srcElem.value;
				address = escape(address);
				aimElem = srcElem;
				break;
			}
			srcElem = srcElem.parentNode;
		}

		if (valid) {
			var mousePos = mouseCoords(evt);
			var pos = mousePos.x + "," + mousePos.y;
			var n=new Date().getTime();
			var c=escape(n*1000+Math.round(Math.random()*1000));
			var u="";var il="";var ho=0;var go="";
			var parent = aimElem.parentNode;
			//统计模块点击量
			while(!parent.id){
				parent = parent.parentNode;
			}
			mod = parent.id;
			//统计元素坐标
			epos = getLeft(aimElem) + "," + getTop(aimElem);	
			with(document) {
				if(cookie.indexOf("SMYUV=")<0) {
					cookie="SMYUV="+c+";path=/;expires=Sun, 29 July 2046 00:00:00 UTC;domain=sogou.com";u=c;
				} else {
					u = m_ws02("SMYUV");
				}
				if(domain.indexOf("sogou.com")>=0)
					m_ws03img.src="http://220.181.69.113/ct.gif?t="+c+"&u="+u+"&type="+aimElem.tagName.toUpperCase()+"&ol="+address+"&mod="+mod+"&epos="+epos+"&pos="+pos+"&lc="+escape(location.href);
			}
		}
	}
	catch(e){}
	return true;
}

	try{
		if (document.attachEvent)
			document.attachEvent("onclick", m_ws03);
		else
			document.addEventListener("click", m_ws03, false);
	}catch(e){}//loadtime pingback
var lt_img=document.createElement('img');
var url = location.href;
var type = "index";
if(url.indexOf("help") != -1 || url.indexOf("privacy") != -1)
type = "help";
else if(url.indexOf("changelog") != -1)
type = "changelog";
else if(url.indexOf("3years") != -1)
type = "3years";
var h = url.indexOf("?") == -1?url.length:url.indexOf("?");
url = url.substring(0,h);
var c=escape(n*1000+Math.round(Math.random()*1000));
var m=new Date().getTime();var c=escape(m*1000+Math.round(Math.random()*1000));var u="";
with(document){
	var ref = referrer==""?m_ws02("redref"):referrer;
	if(cookie.indexOf("SMYUV=")<0)
	{cookie="SMYUV="+c+";path=/;expires=Sun, 29 July 2046 00:00:00 UTC;domain=sogou.com";u=c;}
	else u=m_ws02("SMYUV");}
	window.onload = function() {
		var l = new Date().getTime();
		// lt_img.src = "http://pinyin.sogou.com/loadtime.gif?u="+u+"&t="+(s-n) + "&t2=" + (l-n)+"&url=" + url + "&type=" + type;
		lt_img.src = "http://pinyin.sogou.com/pv.gif?t="+c+"&u="+u+"&r="+ref+"&t="+(s-n) + "&t2=" + (l-n)+"&url=" + url + "&type=" + type;
	}
var s = new Date().getTime();
