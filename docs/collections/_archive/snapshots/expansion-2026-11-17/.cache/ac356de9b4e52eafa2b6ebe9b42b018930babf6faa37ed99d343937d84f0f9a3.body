<section data-mw-section-id="-1" id="mwAd4" aria-labelledby="iPad"><div class="mw-heading mw-heading3"><h3 id="iPad">iPad</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=IOS_7&amp;action=edit&amp;section=29" title="Edit section: iPad"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
