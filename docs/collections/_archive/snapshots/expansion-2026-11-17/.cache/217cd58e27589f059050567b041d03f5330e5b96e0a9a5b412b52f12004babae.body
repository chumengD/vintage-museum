					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="en" dir="ltr" data-mw-parsoid-version="0.25.0.0-alpha1" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Short description","href":"./Template:Short_description"},"params":{"1":{"wt":"Web browser developed by Google"}},"i":0}}]}'>Web browser developed by Google</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_is_different_from_Wikidata"/></span>
<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" id="mwAw" data-mw='{"parts":[{"template":{"target":{"wt":"About","href":"./Template:About"},"params":{"1":{"wt":"the proprietary web browser"},"2":{"wt":"the free and open-source software project"},"3":{"wt":"Chromium (web browser)"},"4":{"wt":"the operating system"},"5":{"wt":"ChromeOS"},"7":{"wt":"Chrome (disambiguation)"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1368532237" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .hatnote{font-style:italic}.mw-parser-output div.hatnote{padding-left:1.6em;margin-bottom:0.5em}.mw-parser-output .hatnote i{font-style:normal}.mw-parser-output .hatnote+.mw-empty-elt+.hatnote{margin-top:-0.5em}@media print{body.ns-0 .mw-parser-output .hatnote{display:none!important}}</style></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt2" id="mwBA">This article is about the proprietary web browser. For the free and open-source software project, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Chromium_(web_browser)" title="Chromium (web browser)">Chromium (web browser)</a>. For the operating system, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ChromeOS" title="ChromeOS">ChromeOS</a>. For other uses, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Chrome_(disambiguation)" title="Chrome (disambiguation)" class="mw-redirect mw-disambig">Chrome (disambiguation)</a>.</div>
<p class="mw-empty-elt" id="mwBQ"><span typeof="mw:Nowiki mw:Transclusion" about="#mwt4" id="mwBg" data-mw='{"parts":[{"template":{"target":{"wt":"pp-vandalism","href":"./Template:Pp-vandalism"},"params":{"small":{"wt":"yes"}},"i":0}}]}'></span><meta typeof="mw:Extension/indicator" about="#mwt4" id="mwBw" data-mw='{"name":"indicator","attrs":{"name":"pp-default"},"body":{"extsrc":"[[File:Semi-protection-shackle.svg|20px|link=Wikipedia:Protection policy#semi|alt=Page semi-protected|This article is semi-protected due to vandalism]]"}}'/><link rel="mw:PageProp/Category" href="./Category:Wikipedia_pages_semi-protected_against_vandalism#Google%20Chrome" about="#mwt4" id="mwCA"/>
<span typeof="mw:Nowiki mw:Transclusion" about="#mwt6" id="mwCQ" data-mw='{"parts":[{"template":{"target":{"wt":"Use mdy dates","href":"./Template:Use_mdy_dates"},"params":{"date":{"wt":"October 2026"}},"i":0}}]}'></span><link rel="mw:PageProp/Category" href="./Category:Use_mdy_dates_from_October_2026" about="#mwt6" id="mwCg"/>
<span typeof="mw:Nowiki mw:Transclusion" about="#mwt7" id="mwCw" data-mw='{"parts":[{"template":{"target":{"wt":"Use American English","href":"./Template:Use_American_English"},"params":{"date":{"wt":"October 2026"}},"i":0}}]}'></span><link rel="mw:PageProp/Category" href="./Category:Use_American_English_from_October_2026" about="#mwt7"/><link rel="mw:PageProp/Category" href="./Category:All_Wikipedia_articles_written_in_American_English" about="#mwt7" id="mwDA"/></p>
<span class="mw-empty-elt" about="#mwt8" typeof="mw:Transclusion" id="mwDQ" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox software\n","href":"./Template:Infobox_software"},"params":{"name":{"wt":"Google Chrome"},"logo":{"wt":"Google Chrome.svg"},"logo size":{"wt":"120px"},"logo alt":{"wt":"The Google Chrome logo, a blue circle surrounded by a thicker band that contains three colored segments. The outer band is red, yellow, and green."},"logo_caption":{"wt":"Logo used since March 2022"},"screenshot":{"wt":"Google Chrome on Windows 10 screenshot.png"},"screenshot size":{"wt":"250px"},"screenshot alt":{"wt":"This is a screenshot of the Chrome browser. The browser has one tab open. The website opened in the browser is English Wikipedia&apos;s main page."},"caption":{"wt":"Screenshot of Google Chrome on [[Windows 10]], showing the [[Main Page]] of the [[English Wikipedia]]"},"developer":{"wt":"[[Google]]"},"released":{"wt":"{{Multiple releases\n|branch1=Windows|version1=Beta|date1={{start date and age|2008|09|02}}\n|branch2=Windows|version2=1.0|date2={{start date and age|2008|12|11}}\n|branch3=macOS, Linux|version3=Preview|date3={{start date and age|2009|06|04}}\n|branch4=macOS, Linux|version4=Beta|date4={{start date and age|2009|12|08}}\n|branch5=Multi&amp;shy;platform|version5=5.0|date5={{start date and age|2010|05|25}}\n}}"},"ver layout":{"wt":"stacked"},"latest release version":{"wt":""},"replaces":{"wt":"[[Google Toolbar]]"},"programming language":{"wt":"[[C (programming language)|C]], [[C++]], [[Rust (programming language)|Rust]], [[Assembly language|Assembly]], [[HTML]], [[Java (programming language)|Java]] (Android app only), [[Swift (programming language)|Swift]] (iOS/iPadOS/macOS app only), [[Objective-C]] (iOS/iPadOS/macOS app only), [[JavaScript]], [[Python (programming language)|Python]]&lt;ref>{{cite web |title=Chromium (Google Chrome) |url=https://www.ohloh.net/p/chrome/analyses/latest |website=Ohloh.net |access-date=February 8, 2012 |archive-url=https://web.archive.org/web/20120421031445/https://www.ohloh.net/p/chrome/analyses/latest |archive-date=April 21, 2012 |url-status=dead}}&lt;/ref>&lt;ref>{{cite web |url=https://chromium.googlesource.com/chromium/src/+/master/styleguide/styleguide.md |title=Chromium coding style |author=&lt;!--Not stated--> |website=Google Open Source |access-date=March 29, 2017 |archive-url=https://web.archive.org/web/20200614164543/https://chromium.googlesource.com/chromium/src/+/master/styleguide/styleguide.md |archive-date=June 14, 2020 |url-status=live}}&lt;/ref>&lt;ref>{{cite web |url=https://www.lextrait.com/Vincent/implementations.html |title=The Programming Languages Beacon, v10.0 |first=Vincent |last=Lextrait |date=January 2010 |access-date=March 14, 2010}}&lt;/ref>"},"operating system":{"wt":"{{Plainlist|\n* [[Android 10]] or later&lt;ref name=\"support.google.com\">{{cite web |url=https://support.google.com/chrome/a/answer/7679408?hl=en |title=Chrome Enterprise and Education release notes |website=[[Google Groups]] |date=October 25, 2022 |access-date=October 27, 2022 |archive-url=https://web.archive.org/web/20210203004833/https://support.google.com/chrome/a/answer/7679408?hl=en |archive-date=February 3, 2021 |url-status=live}}&lt;/ref>\n* [[ChromeOS]]\n* [[iOS 18]] or later&lt;ref name=\"iOSlatest\">{{cite web |url=https://apps.apple.com/us/app/google-chrome/id535886823 |title=Google Chrome (iOS) |date=May 20, 2026 |access-date=August 25, 2020 |archive-url=https://web.archive.org/web/20210203192219/https://apps.apple.com/us/app/google-chrome/id535886823 |archive-date=February 3, 2021 |url-status=live}}&lt;/ref>\n* [[iPadOS 18]] or later\n* [[Linux]]\n* [[macOS Ventura]] or later\n* [[Windows 10]] or later\n* [[Windows Server 2016]] or later\n}}"},"included with":{"wt":"{{Plainlist|\n* [[Android 10]] or later\n* [[ChromeOS]]\n}}"},"engines":{"wt":"[[Blink (browser engine)|Blink]] ([[WebKit]] on iOS/iPadOS), [[V8 (JavaScript engine)|V8 JavaScript engine]]"},"platform":{"wt":"[[IA-32]], [[x86-64]], [[ARMv7]], [[ARMv8-A]], [[ARMv9-A]]"},"language count":{"wt":"47"},"language footnote":{"wt":"&lt;ref>{{cite web |url=https://support.google.com/googleplay/android-developer/table/4419860? |title=Supported languages |website=Google Play Console Help |access-date=December 18, 2015 |archive-date=May 1, 2016 |archive-url=https://web.archive.org/web/20160501004423/https://support.google.com/googleplay/android-developer/table/4419860 |url-status=live}}&lt;/ref>"},"language":{"wt":""},"genre":{"wt":"[[Web browser]], [[mobile browser]]"},"license":{"wt":"[[Proprietary software|Proprietary]] [[freeware]], based on open-source components&lt;ref name=\"TOS\">{{cite web |url=https://www.google.com/intl/en/chrome/terms/ |title=Google Chrome and Chrome OS Additional Terms of Service |website=google.com |access-date=August 25, 2020 |archive-date=January 24, 2018 |archive-url=https://web.archive.org/web/20180124042413/https://www.google.com/intl/en/chrome/browser/privacy/eula_text.html |url-status=live}}&lt;/ref>&lt;ref group=note>Chrome&apos;s [[WebKit]] and [[Blink (browser engine)|Blink]] layout engines and its [[V8 (JavaScript engine)|V8 JavaScript engine]] are each [[free and open-source software]], while its other components are each either open-source or [[Proprietary software|proprietary]]. However, section 9 of [https://www.google.com/intl/en/chrome/browser/privacy/eula_text.html Google Chrome&apos;s Terms of Service] {{Webarchive|url=https://web.archive.org/web/20180124042413/https://www.google.com/intl/en/chrome/browser/privacy/eula_text.html |date=January 24, 2018}} designates the whole package as proprietary [[freeware]].&lt;/ref>"},"website":{"wt":"{{URL|https://google.com/chrome}}"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1385617415" typeof="mw:Extension/templatestyles" about="#mwt9" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output