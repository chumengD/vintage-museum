<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_10" title="Windows 10">Windows 10</a> or later</li>
<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Server_2016" title="Windows Server 2016">Windows Server 2016</a> or later</li></ul>

</div></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Computing_platform" title="Computing platform">Platform</a></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IA-32" title="IA-32">IA-32</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/X86-64" title="X86-64">x86-64</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ARMv7" title="ARMv7" class="mw-redirect">ARMv7</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ARMv8-A" title="ARMv8-A" class="mw-redirect">ARMv8-A</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ARMv9-A" title="ARMv9-A" class="mw-redirect">ARMv9-A</a></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Included with</th><td class="infobox-data"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1126788409" about="#mwt73" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Plainlist/styles.css"}}'/><div class="plainlist ">
