</td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Written in</th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/C_(programming_language)" title="C (programming language)">C</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/C++" title="C++">C++</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Rust_(programming_language)" title="Rust (programming language)">Rust</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Assembly_language" title="Assembly language">Assembly</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/HTML" title="HTML">HTML</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Java_(programming_language)" title="Java (programming language)">Java</a> (Android app only), <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Swift_(programming_language)" title="Swift (programming language)">Swift</a> (iOS/iPadOS/macOS app only), <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Objective-C" title="Objective-C">Objective-C</a> (iOS/iPadOS/macOS app only), <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/JavaScript" title="JavaScript">JavaScript</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Python_(programming_language)" title="Python (programming language)">Python</a><sup about="#mwt49" class="mw-ref reference" id="cite_ref-9" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-9"}}'><a href="#cite_note-9" id="mwLg"><span class="mw-reflink-text" id="mwLw"><span class="cite-bracket" id="mwMA">[</span>9<span class="cite-bracket" id="mwMQ">]</span></span></a></sup><sup about="#mwt54" class="mw-ref reference" id="cite_ref-10" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-10"}}'><a href="#cite_note-10" id="mwMg"><span class="mw-reflink-text" id="mwMw"><span class="cite-bracket" id="mwNA">[</span>10<span class="cite-bracket" id="mwNQ">]</span></span></a></sup><sup about="#mwt59" class="mw-ref reference" id="cite_ref-11" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-11"}}'><a href="#cite_note-11" id="mwNg"><span class="mw-reflink-text" id="mwNw"><span class="cite-bracket" id="mwOA">[</span>11<span class="cite-bracket" id="mwOQ">]</span></span></a></sup></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Software_engine" title="Software engine">Engines</a></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Blink_(browser_engine)" title="Blink (browser engine)">Blink</a> (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/WebKit" title="WebKit">WebKit</a> on iOS/iPadOS), <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/V8_(JavaScript_engine)" title="V8 (JavaScript engine)">V8 JavaScript engine</a></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Operating_system" title="Operating system">Operating system</a></th><td class="infobox-data"><style data-mw-deduplicate="TemplateStyles:r1126788409" typeof="mw:Extension/templatestyles" about="#mwt62" data-mw='{"name":"templatestyles","attrs":{"src":"Plainlist/styles.css"}}'>.mw-parser-output .plainlist ol,.mw-parser-output .plainlist ul{line-height:inherit;list-style:none;margin:0;padding:0}.mw-parser-output .plainlist ol li,.mw-parser-output .plainlist ul li{margin-bottom:0}</style><div class="plainlist ">
<ul><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Android_10" title="Android 10">Android 10</a> or later<sup about="#mwt65" class="mw-ref reference" id="cite_ref-support.google.com_12-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"support.google.com"},"body":{"id":"mw-reference-text-cite_note-support.google.com-12"}}'><a href="#cite_note-support.google.com-12" id="mwOg"><span class="mw-reflink-text" id="mwOw"><span class="cite-bracket" id="mwPA">[</span>12<span class="cite-bracket" id="mwPQ">]</span></span></a></sup></li>
<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ChromeOS" title="ChromeOS">ChromeOS</a></li>
<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IOS_18" title="IOS 18">iOS 18</a> or later<sup about="#mwt70" class="mw-ref reference" id="cite_ref-iOSlatest_13-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"iOSlatest"},"body":{"id":"mw-reference-text-cite_note-iOSlatest-13"}}'><a href="#cite_note-iOSlatest-13" id="mwPg"><span class="mw-reflink-text" id="mwPw"><span class="cite-bracket" id="mwQA">[</span>13<span class="cite-bracket" id="mwQQ">]</span></span></a></sup></li>
