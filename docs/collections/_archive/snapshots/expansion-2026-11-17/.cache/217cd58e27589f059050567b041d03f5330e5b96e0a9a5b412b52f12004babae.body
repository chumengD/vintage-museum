<li about="#cite_note-182" id="cite_note-182" data-mw-footnote-number="181"><span class="mw-cite-backlink" id="mwEeI"><a href="#cite_ref-182" rel="mw:referencedBy" id="mwEeM"><span class="mw-linkback-text" id="mwEeQ">↑</span></a></span> <span id="mw-reference-text-cite_note-182" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt628" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwEeU" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite news ","href":"./Template:Cite_news"},"params":{"last":{"wt":"Delgado"},"first":{"wt":"Juan Manuel"},"title":{"wt":"Expertos en privacidad y ciberseguridad de todo el mundo no dudan: \"Debes decirle adiós a Chrome\""},"url":{"wt":"https://computerhoy.20minutos.es/google/expertos-ciberseguridad-privacidad-adios-google-chrome-1462101"},"archive-url":{"wt":"https://web.archive.org/web/20260324082924/https://computerhoy.20minutos.es/google/expertos-ciberseguridad-privacidad-adios-google-chrome-1462101"},"archive-date":{"wt":"March 24, 2026"},"access-date":{"wt":"March 24, 2026"},"work":{"wt":"Computer Hoy"},"language":{"wt":"es-ES"}},"i":0}}]}'/><cite id="CITEREFDelgado" class="citation news cs1 cs1-prop-foreign-lang-source" about="#mwt628">Delgado, Juan Manuel. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20260324082924/https://computerhoy.20minutos.es/google/expertos-ciberseguridad-privacidad-adios-google-chrome-1462101" class="external text" id="mwEeY">"Expertos en privacidad y ciberseguridad de todo el mundo no dudan: "Debes decirle adiós a Chrome"<span class="cs1-kern-right" id="mwEec"></span>"</a>. <i id="mwEeg">Computer Hoy</i> (in European Spanish). Archived from <a rel="mw:ExtLink nofollow" href="https://computerhoy.20minutos.es/google/expertos-ciberseguridad-privacidad-adios-google-chrome-1462101" class="external text" id="