ev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=blog.chromium.org&amp;rft.atitle=Chromium+Blog%3A+The+road+to+safer%2C+more+stable%2C+and+flashier+Flash&amp;rft.date=2012-08-08&amp;rft_id=https%3A%2F%2Fblog.chromium.org%2F2012%2F08%2Fthe-road-to-safer-more-stable-and.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AGoogle+Chrome" class="Z3988" about="#mwt607" id="mwEaE"></span></span></li>
<li about="#cite_note-SecureFlashMac-176" id="cite_note-SecureFlashMac-176" data-mw-footnote-number="175"><span class="mw-cite-backlink" id="mwEaI"><a href="#cite_ref-SecureFlashMac_176-0" rel="mw:referencedBy" id="mwEaM"><span class="mw-linkback-text" id="mwEaQ">↑</span></a></span> <span id="mw-reference-text-cite_note-SecureFlashMac-176" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt1411" typeof="mw:Extension/templatestyles" id="mwEaU" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""}}'/><cite class="citation news cs1" id="mwEaY"><a rel="mw:ExtLink nofollow" href="https://chrome.blogspot.com/2012/11/securing-flash-player-for-our-mac-users.html" class="external text" id="mwEac">"Securing Flash Player for our Mac users"</a>. <i id="mwEag">Google Chrome Blog</i><span class="reference-accessdate" id="mwEak">. Retrieved <span class="nowrap" id="mwEao">November 14,</span> 2012</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Google+Chrome+Blog&amp;rft.atitle=Securing+Flash+Player+for+our+Mac+users&amp;rft_id=https%3A%2F%2Fchrome.blogspot.com%2F2012%2F11%2Fsecuring-flash-player-for-our-mac-users.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AGoogle+Chrome" class="Z3988" id="mwEas"></span></span></li>
<li about="#cite_note-177" id="cite_note-177" data-mw-footnote-number="176"><span class="mw-cite-backlink" id="mwEaw"><a href="#cite_ref-177" rel="mw:referencedBy" id="mwEa0"><span class="mw-linkback-text" id="mwEa4">↑</span></a></span> <span id="mw-reference-text-cite_note-177" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt611" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwEa8" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://blog.chromium.org/2013/09/saying-goodbye-to-our-old-friend-npapi.html"},"title":{"wt":"Chromium Blog: Saying Goodbye to Our Old Friend NPAPI"},"work":{"wt":"Chromium Blog"},"access-date":{"wt":"July 13, 2015"},"archive-date":{"wt":"January 22, 2021"},"archive-url":{"wt":"https://web.archive.org/web/20210122184036/https://blog.chromium.org/2013/09/saying-goodbye-to-our-old-friend-npapi.html"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt611" id="mwEbA"><a rel="mw:ExtLink nofollow" href="https://blog.chromium.org/2013/09/saying-goodbye-to-our-old-friend-npapi.html" class="external text" id="mwEbE">"Chromium Blog: Saying Goodbye to Our Old Friend NPAPI"</a>. <i id="mwEbI">Chromium Blog</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20210122184036/https://blog.chromium.org/2013/09/saying-goodbye-to-our-old-friend-npapi.html" class="external text" id="mwEbM">Archived</a> from the original on January 22, 2021<span class="reference-accessdate" id="mwEbQ">. Retrieved <span class="nowrap" id="mwEbU">July 13,</span> 2015</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Chromium+Blog&amp;rft.atitle=Chromium+Blog%3A+Saying+Goodbye+to+Our+Old+Friend+NPAPI&amp;rft_id=https%3A%2F%2Fblog.chromium.org%2F2013%2F09%2Fsaying-goodbye-to-our-old-friend-npapi.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AGoogle+Chrome" class="Z3988" about="#mwt611" id="mwEbY"></span></span></li>
<li about="#cite_note-178" id="cite_note-178" data-mw-footnote-number="177"><span class="mw-cite-backlink" id="mwEbc"><a href="#cite_ref-178" rel="mw:referencedBy" id="mwEbg"><span class="mw-linkback-text" id="mwEbk">↑</span></a></span> <span id="mw-reference-text-cite_note-178" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt614" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwEbo" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://groups.google.com/a/chromium.org/forum/#!topic/chromium-dev/xEbgvWE7wMk"},"title":{"wt":"PSA: Chrome for Linux planning to drop NPAPI support as soon as April"},"quote":{"wt":"Another thing I found last night is a Debian package called PepperFlashPlayer. Apparently, it works the same way as the existing FlashPlayer package (which downloads Adobe Flash from Adobe and installs it) -- it downloads Chrome from Google, extracts the PPAPI Flash plugin, and installs it for Chromium. That might be a good workaround for Chromium users in the interim. (Note: I am not endorsing this method, just making people aware of it.) But obviously, it would be better if PPAPI Flash were available in a more \"official\" context."},"access-date":{"wt":"April 22, 2015"},"archive-date":{"wt":"May 23, 2013"},"archive-url":{"wt":"https://web.archive.org/web/20130523081122/http://groups.google.com/a/chromium.org/group/chromium-os-dev/browse_thread/thread/337cca9a0da59ad6/9354a38894da5df5#!topic/chromium-dev/xEbgvWE7wMk"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt614" id="mwEbs"><a rel="mw:ExtLink nofollow" href="https://groups.google.com/a/chromium.org/forum/#!topic/chromium-dev/xEbgvWE7wMk" class="external text" id="mwEbw">"PSA: Chrome for Linux planning to drop NPAPI support as soon as April"</a>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20130523081122/http://groups.google.com/a/chromium.org/group/chromium-os-dev/browse_thread/thread/337cca9a0da59ad6/9354a38894da5df5#!topic/chromium-dev/xEbgvWE7wMk" class="external text" id="mwEb0">Archived</a> from the original on May 23, 2013<span class="reference-accessdate" id="mwEb4">. Retrieved <span class="nowrap" id="mwEb8">April 22,</span> 2015</span>. <q id="mwEcA">Another thing I found last night is a Debian package called PepperFlashPlayer. Apparently, it works the same way as the existing FlashPlayer package (which downloads Adobe Flash from Adobe and installs it) -- it downloads Chrome from Google, extracts the PPAPI Flash plugin, and installs it for Chromium. That might be a good workaround for Chromium users in the interim. (Note: I am not endorsing this method, just making people aware of it.) But obviously, it would be better if PPAPI Flash were available in a more "official" context.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=PSA%3A+Chrome+for+Linux+planning+to+drop+NPAPI+support+as+soon+as+April&amp;rft_id=https%3A%2F%2Fgroups.google.com%2Fa%2Fchromium.org%2Fforum%2F%23%21topic%2Fchromium-dev%2FxEbgvWE7wMk&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AGoogle+Chrome" class="Z3988" about="#mwt614" id="mwEcE"></span></span></li>
<li about="#cite_note-179" id="cite_note-179" data-mw-footnote-number="178"><span class="mw-cite-backlink" id="mwEcI"><a href="#cite_ref-179" rel="mw:referencedBy" id="mwEcM"><span class="mw-linkback-text" id="mwEcQ">↑</span></a></span> <span id="mw-reference-text-cite_note-179" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt618" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwEcU" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://www.w3.org/2011/tracking-protection/drafts/tracking-dnt.html#determining"},"publisher":{"wt":"W3C"},"access-date":{"wt":"December 17, 2015"},"title":{"wt":"Tracking DNT"},"archive-date":{"wt":"December 31, 2015"},"archive-url":{"wt":"https://web.archive.org/web/20151231003129/http://www.w3.org/2011/tracking-protection/drafts/tracking-dnt.html#determining"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt618" id="mwEcY"><a rel="mw:ExtLink nofollow" href="https://www.w3.org/2011/tracking-protection/drafts/tracking-dnt.html#determining" class="external text" id="mwEcc">"Tracking DNT"</a>. W3C. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20151231003129/http://www.w3.org/2011/tracking-protection/drafts/tracking-dnt.html#determining" class="external text" id="mwEcg">Archived</a> from the original on December 31, 2015<span class="reference-accessdate" id="mwEck">. Retrieved <span class="nowrap" id="mwEco">December 17,</span> 2015</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Tracking+DNT&amp;rft.pub=W3C&amp;rft_id=https%3A%2F%2Fwww.w3.org%2F2011%2Ftracking-protection%2Fdrafts%2Ftracking-dnt.html%23determining&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AGoogle+Chrome" class="Z3988" about="#mwt618" id="mwEcs"></span></span></li>
<li about="#cite_note-180" id="cite_note-180" data-mw-footnote-number="179"><span class="mw-cite-backlink" id="mwEcw"><a href="#cite_ref-180" rel="mw:referencedBy" id="mwEc0"><span class="mw-linkback-text" id="mwEc4">↑</span></a></span> <span id="mw-reference-text-cite_note-180" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt621" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwEc8" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://browserfame.com/478/google-chrome-support-do-not-track"},"title":{"wt":"Google and Chrome To Support Do Not Track"},"access-date":{"wt":"March 3, 2012"},"url-status":{"wt":"dead"},"archive-url":{"wt":"https://web.archive.org/web/20120226042318/https://browserfame.com/478/google-chrome-support-do-not-track"},"archive-date":{"wt":"February 26, 2012"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt621" id="mwEdA"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20120226042318/https://browserfame.com/478/google-chrome-support-do-not-track" class="external text" id="mwEdE">"Google and Chrome To Support Do Not Track"</a>. Archived from <a rel="mw:ExtLink nofollow" href="https://browserfame.com/478/google-chrome-support-do-not-track" class="external text" id="mwEdI">the original</a> on February 26, 2012<span class="reference-accessdate" id="mwEdM">. Retrieved <span class="nowrap" id="mwEdQ">March 3,</span> 2012</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Google+and+Chrome+To+Support+Do+Not+Track&amp;rft_id=https%3A%2F%2Fbrowserfame.com%2F478%2Fgoogle-chrome-support-do-not-track&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AGoogle+Chrome" class="Z3988" about="#mwt621" id="mwEdU"><