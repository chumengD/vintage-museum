<div class='cmt_iframe_holder' data-href='https://blog.chromium.org/2008/09/dns-prefetching-or-pre-resolving.html' data-viewtype='FILTERED_POSTMOD'></div>
<a href='https://plus.google.com/112374322230920073195' rel='author' style='display:none;'>
                        Google
                      </a>
