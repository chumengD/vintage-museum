<li about="#cite_note-justice-gov-98-1232-10" id="cite_note-justice-gov-98-1232-10" data-mw-footnote-number="7"><span class="mw-cite-backlink" id="mwBIg"><a href="#cite_ref-justice-gov-98-1232_10-0" rel="mw:referencedBy" id="mwBIk"><span class="mw-linkback-text" id="mwBIo">↑</span></a></span> <span id="mw-reference-text-cite_note-justice-gov-98-1232-10" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt47" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBIs" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://www.justice.gov/atr/cases/f2600/2613-1.htm"},"title":{"wt":"U.S. Antitrust Case 98-1232"},"publisher":{"wt":"justice.gov"},"access-date":{"wt":"February 6, 2015"},"author":{"wt":"Paul Maritz"},"quote":{"wt":"There is talk about how we get more $&apos;s from the 1000+ people we have working on browser related stuff..."}},"i":0}}]}'/><cite id="CITEREFPaul_Maritz" class="citation web cs1" about="#mwt47">Paul Maritz. <a rel="mw:ExtLink nofollow" href="https://www.justice.gov/atr/cases/f2600/2613-1.htm" class="external text" id="mwBIw">"U.S. Antitrust Case 98-1232"</a>. justice.gov<span class="reference-accessdate" id="mwBI0">. Retrieved <span class="nowrap" id="mwBI4">February 6,</span> 2015</span>. <q id="mwBI8">There is talk about how we get more $'s from the 1000+ people we have working on browser related stuff...</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=U.S.+Antitrust+Case+98-1232&amp;rft.pub=justice.gov&amp;rft.au=Paul+Maritz&amp;rft_id=https%3A%2F%2Fwww.justice.gov%2Fatr%2Fcases%2Ff2600%2F2613-1.htm&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AInternet+Explorer" class="Z3988" about="#mwt47" id="mwBJA"></span></span></li>
<li about="#cite_note-11" id="cite_note-11" data-mw-footnote-number="8"><span class="mw-cite-backlink" id="mwBJE"><a href="#cite_ref-11" rel="mw:referencedBy" id="mwBJI"><span class="mw-linkback-text" id="mwBJM">↑</span></a></span> <span id="mw-reference-text-cite_note-11" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt50" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBJQ" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web ","href":"./Template:Cite_web"},"params":{"title":{"wt":"TSP100 on Microsoft Edge Browser - Windows 10"},"url":{"wt":"https://support.mindbodyonline.com/s/article/211651567-TSP100-on-Microsoft-Edge-Browser-Windows-10?language=en_US"},"url-status":{"wt":"live"},"archive-url":{"wt":"https://web.archive.org/web/20250107224656/https://support.mindbodyonline.com/s/article/211651567-TSP100-on-Microsoft-Edge-Browser-Windows-10?language=en_US"},"archive-date":{"wt":"January 7, 2025"},"access-date":{"wt":"2025-12-04"},"website":{"wt":"MINDBODY"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt50" id="mwBJU"><a rel="mw:ExtLink nofollow" href="https://support.mindbodyonline.com/s/article/211651567-TSP100-on-Microsoft-Edge-Browser-Windows-10?language=en_US" class="external text" id="mwBJY">"TSP100 on Microsoft Edge Browser - Windows 10"</a>. <i id="mwBJc">MINDBODY</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20250107224656/https://support.mindbodyonline.com/s/article/211651567-TSP100-on-Microsoft-Edge-Browser-Windows-10?language=en_US" class="external text" id="mwBJg">Archived</a> from the original on January 7, 2025<span class="reference-accessdate" id="mwBJk">. Retrieved <span class="nowrap" id="mwBJo">December 4,</span> 2025</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=MINDBODY&amp;rft.atitle=TSP100+on+Microsoft+Edge+Browser+-+Windows+10&amp;rft_id=https%3A%2F%2Fsupport.mindbodyonline.com%2Fs%2Farticle%2F211651567-TSP100-on-Microsoft-Edge-Browser-Windows-10%3Flanguage%3Den_US&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AInternet+Explorer" class="Z3988" about="#mwt50" id="mwBJs"></span></span></li>
<li about="#cite_note-is-ie-discontinued-12" id="cite_note-is-ie-discontinued-12" data-mw-footnote-number="9"><span rel="mw:referencedBy" class="mw-cite-backlink" id="mwBJw"><a href="#cite_ref-is-ie-discontinued_12-0" id="mwBJ0"><span class="mw-linkback-text" id="mwBJ4">1</span></a> <a href="#cite_ref-is-ie-discontinued_12-1" id="mwBJ8"><span class="mw-linkback-text" id="mwBKA">2</span></a></span> <span id="mw-reference-text-cite_note-is-ie-discontinued-12" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt53" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBKE" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://developer.microsoft.com/en-us/microsoft-edge/platform/faq/"},"title":{"wt":"Frequently Asked Questions"},"website":{"wt":"Microsoft Edge Development"},"publisher":{"wt":"[[Microsoft]]"},"archive-url":{"wt":"https://web.archive.org/web/20160716113141/https://developer.microsoft.com/en-us/microsoft-edge/platform/faq/"},"archive-date":{"wt":"July 16, 2016"},"url-status":{"wt":"dead"},"quote":{"wt":"The latest features and platform updates will only be available in Microsoft Edge. We will continue to deliver security updates to Internet Explorer 11 through its supported lifespan. To ensure consistent behavior across Windows versions, we will evaluate Internet Explorer 11 bugs for servicing on a case by case basis."}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt53" id="mwBKI"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20160716113141/https://developer.microsoft.com/en-us/microsoft-edge/platform/faq/" class="external text" id="mwBKM">"Frequently Asked Questions"</a>. <i id="mwBKQ">Microsoft Edge Development</i>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Microsoft" title="Microsoft" id="mwBKU">Microsoft</a>. Archived from <a rel="mw:ExtLink nofollow" href="https://developer.microsoft.com/en-us/microsoft-edge/platform/faq/" class="external text" id="mwBKY">the original</a> on July 16, 2016. <q id="mwBKc">The latest features and platform updates will only be available in Microsoft Edge. We will continue to deliver security updates to Internet Explorer 11 through its supported lifespan. To ensure consistent behavior across Windows versions, we will evaluate Internet Explorer 11 bugs for servicing on a case by case basis.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Microsoft+Edge+Development&amp;rft.atitle=Frequently+Asked+Questions&amp;rft_id=https%3A%2F%2Fdeveloper.microsoft.com%2Fen-us%2Fmicrosoft-edge%2Fplatform%2Ffaq%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AInternet+Explorer" class="Z3988" about="#mwt53" id="mwBKg"></span></span></li>
<li about="#cite_note-13" id="cite_note-13" data-mw-footnote-number="10"><span class="mw-cite-backlink" id="mwBKk"><a href="#cite_ref-13" rel="mw:referencedBy" id="mwBKo"><span class="mw-linkback-text" id="mwBKs">↑</span></a></span> <span id="mw-reference-text-cite_note-13" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt56" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBKw" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite news","href":"./Template:Cite_news"},"params":{"url":{"wt":"https://www.bbc.co.uk/news/10095730"},"work":{"wt":"BBC News"},"title":{"wt":"Microsoft&apos;s Internet Explorer losing browser share"}},"i":0}}]}'/><cite class="citation news cs1" about="#mwt56" id="mwBK0"><a rel="mw:ExtLink nofollow" href="https://www.bbc.co.uk/news/10095730" class="external text" id="mwBK4">"Microsoft's Internet Explorer losing browser share"</a>. <i id="mwBK8">BBC News</i>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=BBC+News&amp;rft.atitle=Microsoft%27s+Internet+Explorer+losing+browser+share&amp;rft_id=https%3A%2F%2Fwww.bbc.co.uk%2Fnews%2F10095730&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AInternet+Explorer" class="Z3988" about="#mwt56" id="mwBLA"></span></span></li>
