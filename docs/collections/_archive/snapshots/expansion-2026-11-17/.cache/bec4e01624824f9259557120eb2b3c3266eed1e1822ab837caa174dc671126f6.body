<span class="mw-empty-elt" about="#mwt5" typeof="mw:Transclusion" id="mwCA" data-mw='{"parts":[{"template":{"target":{"wt":"For-multi","href":"./Template:For-multi"},"params":{"1":{"wt":"variants"},"2":{"wt":"Internet Explorer for Mac"},"3":{"wt":"and"},"4":{"wt":"Internet Explorer for UNIX"},"5":{"wt":"and"},"6":{"wt":"Internet Explorer Mobile"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1368532237" typeof="mw:Extension/templatestyles" about="#mwt6" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Hatnote/styles.css"},"body":{"extsrc":""}}'>.mw-parser-output .hatnote{font-style:italic}.mw-parser-output div.hatnote{padding-left:1.6em;margin-bottom:0.5em}.mw-parser-output .hatnote i{font-style:normal}.mw-parser-output .hatnote+.mw-empty-elt+.hatnote{margin-top:-0.5em}@media print{body.ns-0 .mw-parser-output .hatnote{display:none!important}}</style></span><div role="note" class="hatnote navigation-not-searchable" about="#mwt5" id="mwCQ">For variants, see <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_Explorer_for_Mac" title="Internet Explorer for Mac">Internet Explorer for Mac</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_Explorer_for_UNIX" title="Internet Explorer for UNIX">Internet Explorer for UNIX</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_Explorer_Mobile" title="Internet Explorer Mobile">Internet Explorer Mobile</a>.</div>
<p class="mw-empty-elt" id="mwCg"><span typeof="mw:Nowiki mw:Transclusion" about="#mwt7" id="mwCw" data-mw='{"parts":[{"template":{"target":{"wt":"Use American English","href":"./Template:Use_American_English"},"params":{"date":{"wt":"July 2022"}},"i":0}}]}'></span><link rel="mw:PageProp/Category" href="./Category:Use_American_English_from_July_2022" about="#mwt7"/><link rel="mw:PageProp/Category" href="./Category:All_Wikipedia_articles_written_in_American_English" about="#mwt7" id="mwDA"/>
<span typeof="mw:Nowiki mw:Transclusion" about="#mwt8" id="mwDQ" data-mw='{"parts":[{"template":{"target":{"wt":"Use mdy dates","href":"./Template:Use_mdy_dates"},"params":{"date":{"wt":"February 2021"}},"i":0}}]}'></span><link rel="mw:PageProp/Category" href="./Category:Use_mdy_dates_from_February_2021" about="#mwt8" id="mwDg"/></p>
<span class="mw-empty-elt" about="#mwt9" typeof="mw:Transclusion" id="mwDw" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox software\n","href":"./Template:Infobox_software"},"params":{"name":{"wt":"Internet Explorer"},"logo":{"wt":"Internet Explorer 10+11 logo.svg"},"logo alt":{"wt":"Small blue \"e\" letter with a blue aureola"},"logo size":{"wt":"70px"},"logo caption":{"wt":"Logo used since 2011"},"screenshot":{"wt":"Internet Explorer 11 screenshot.png"},"caption":{"wt":"Screenshot of [[Internet Explorer 11]], showing the [[Main Page]] of the [[English Wikipedia]]"},"other_names":{"wt":"Microsoft Internet Explorer (versions 1–6)&lt;br>Windows Internet Explorer (versions 7–9)&lt;br>IE"},"author":{"wt":"[[Thomas Reardon]]"},"developer":{"wt":"[[Microsoft]]"},"released":{"wt":"{{Start date and age|1995|8|24}}&lt;ref>{{cite web |url=http://www.microsoft.com/windows/ie/community/columns/historyofie.mspx |title=The History of Internet Explorer |date=August 25, 2005 |publisher=[[Microsoft]] |work=News Center |archive-date=October 1, 2005 |archive-url=https://web.archive.org/web/20051001113951/http://www.microsoft.com/windows/ie/community/columns/historyofie.mspx |url-status=live }}&lt;/ref> (included with Plus! for Windows 95)"},"discontinued":{"wt":"no"},"ver layout":{"wt":"stacked"},"latest release version":{"wt":"{{Multiple releases\n  | branch1 = Windows\n  | version1 = {{wikidata|property|preferred|references|edit|Q1575|P348|P400=Q1406|P548=Q2804309}}\n  | date1 = {{wikidata|qualifier|preferred|single|Q1575|P348|P400=Q1406|P548=Q2804309|P577}}\n  | branch2 = macOS\n  | version2 = {{wikidata|property|preferred|references|edit|Q1575|P348|P400=Q14116|P548=Q2804309}}\n  | date2 = {{wikidata|qualifier|preferred|single|Q1575|P348|P400=Q14116|P548=Q2804309|P577}}\n  | branch3 = Unix\n  | version3 = {{wikidata|property|preferred|references|edit|Q1575|P348|P400=Q11368|P548=Q2804309}}\n  | date3 = {{wikidata|qualifier|preferred|single|Q1575|P348|P400=Q11368|P548=Q2804309|P577}}\n}}"},"latest preview version":{"wt":"{{Multiple releases\n  | branch1 = Windows\n  | version1 = {{wikidata|property|preferred|references|edit|Q1575|P348|P400=Q1406|P548=Q51930650}}\n  | date1 = {{wikidata|qualifier|preferred|single|Q1575|P348|P400=Q1406|P548=Q51930650|P577}}\n  | branch2 = macOS\n  | version2 = {{wikidata|property|preferred|references|edit|Q1575|P348|P400=Q14116|P548=Q51930650}}\n  | date2 = {{wikidata|qualifier|preferred|single|Q1575|P348|P400=Q14116|P548=Q51930650|P577}}\n  | branch3 = Unix\n  | version3 = {{wikidata|property|preferred|references|edit|Q1575|P348|P400=Q11368|P548=Q51930650}}\n  | date3 = {{wikidata|qualifier|preferred|single|Q1575|P348|P400=Q11368|P548=Q51930650|P577}}\n}}"},"operating system":{"wt":"[[Windows]] &lt;small>(previously supported: [[macOS|Mac OS X]], [[Solaris (operating system)|Solaris]], [[HP-UX]])&lt;/small>"},"included with":{"wt":"{{plainlist|\n* [[Microsoft Plus!]] for [[Windows 95]]\n* Windows 95 OSR1 or later\n* [[Windows NT 4.0]] through [[Windows 10, version 21H2|Windows 10 version 21H2]]&lt;!-- [[Windows 11]], but only as \"[[MSHTML]] (Trident) browser engine.\" List that here qualified, or too confusing to list for Windows 11 as not the full application? -->\n* [[Windows Phone 7]] through [[Windows Phone 8.1]]\n* [[Mac OS 8#Mac OS 8.1|Mac OS 8.1]] through [[Mac OS X 10.2]]\n* [[Zune HD]]\n* [[Xbox 360]]\n* [[Xbox One]]\n}}"},"engines":{"wt":"[[MSHTML]] (Trident), [[Chakra (JScript engine)|Chakra]]"},"platform":{"wt":"[[IA-32]], [[x86-64]], [[ARMv7]] &lt;small> (previously supported: [[MIPS architecture|MIPS]], [[DEC Alpha|Alpha]], [[PowerPC]], [[68k]], [[SPARC]], [[PA-RISC]], [[Itanium]])&lt;/small>"},"replaced_by":{"wt":"[[Microsoft Edge (series of web browsers)|Microsoft Edge]]"},"size":{"wt":"&lt;!--Varies; really, really varies. Please include your source.-->"},"language count":{"wt":"95"},"language footnote":{"wt":"&lt;ref>{{Cite web|url=https://blogs.technet.microsoft.com/terminology/2013/02/27/internet-explorer-10-for-windows-7-released-in-95-languages/|title=Internet Explorer 10 for Windows 7 released in 95 languages – Microsoft Language Portal Blog|website=blogs.technet.microsoft.com|date=August 28, 2023 }}&lt;/ref>"},"genre":{"wt":"{{plainlist|\n* [[Web browser]]\n* [[Feed reader]]}}"},"license":{"wt":"[[Proprietary software|Proprietary]], [[end-user license agreement|requires]] a Windows license&lt;ref>{{cite web|title=Microsoft Pre-Release Software License Terms: Internet Explorer 11 Developer Preview|url=http://windows.microsoft.com/en-US/internet-explorer/ie11-win7-preview-software-license|work=microsoft.com|publisher=[[Microsoft]]|access-date=July 27, 2013}}&lt;/ref>"},"website":{"wt":"{{URL|https://microsoft.com/ie}}&lt;!--Redirect; see [[MOS:COMPUTING#Website addresses]]-->"},"standard":{"wt":"[[HTML5]], [[CSS3]], [[WOFF]], [[Scalable Vector Graphics|SVG]], [[RSS]], [[Atom (standard)|Atom]], [[JPEG XR]]"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1385617415" typeof="mw:Extension/templatestyles" about="#mwt10" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'>@media(min-width:640px){.mw-parser-output .infobox{margin-left:1em;float:right;clear:right;width:22em}}.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent;color:inherit}.mw-parser-output .infobox-3cols-child{margin:-3px}.mw-parser-output .infobox .navbar{font-size:100%}.mw-parser-output .infobox-hiddenrow,body.skin--responsive.skin--responsive .mw-parser-output .infobox .infobox-hiddenrow{display:none}@media screen{html.skin-theme-clientpref-night .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:var(--color-base)}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .infobox-full-data:not(.notheme)>div:not(.notheme)[style]{background:#1f1f23!important;color:var(--color-base)}}@media(min-width:640px){body.skin--responsive .mw-parser-output .infobox-table{display:table!important}body.skin--responsive .mw-parser-output .infobox-table>caption{display:table-caption!important}body.skin--responsive .mw-parser-output .infobox-table>tbody{display:table-row-group}body.skin--responsive .mw-parser-output .infobox-table th,body.skin--responsive .mw-parser-output .infobox-table td{padding-left:inherit;padding-right:inherit}}</style></span><table class="infobox vevent" about="#mwt9"><tbody><tr><th colspan="2" class="infobox-above summary">Internet Explorer</th></tr><tr><td colspan="2" class="infobox-image logo"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:Internet_Explorer_10+11_logo.svg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Internet_Explorer_10+11_logo.svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/1/18/Internet_Explorer_10%2B11_logo.svg/120px-Internet_Explorer_10%2B11_logo.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/1/18/Internet_Explorer_10%2B11_logo.svg/250px-Internet_Explorer_10%2B11_logo.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt='Small blue "e" letter with a blue aureola' data-file-width="223" data-file-height="219" data-file-type="drawing" height="69" width="70" class="mw-file-element"/></a></span><div class="infobox-caption">Logo used since 2011</div></td></tr><tr><td colspan="2" class="infobox-image logo"><span class="mw-default-size" typeof="mw:File/Frameless"><a href="https://en.wikipedia.org/wiki/File:Internet_Explorer_11_screenshot.png" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Internet_Explorer_11_screenshot.png" src="//thumb.wikimedia.org/wikipedia/en/thumb/0/00/Internet_Explorer_11_screenshot.png/250px-Internet_Explorer_11_screenshot.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/en/thumb/0/00/Internet_Explorer_11_screenshot.png/500px-Internet_Explorer_11_screenshot.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="543" data-file-height="347" data-file-type="bitmap" height="160" width="250" class="mw-file-element mw-file-upright" style="--mw-file-upright: 1"/></a></span><div class="infobox-caption">Screenshot of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_Explorer_11" title="Internet Explorer 11">Internet Explorer 11</a>, showing the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Main_Page" title="Main Page">Main Page</a> of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/English_Wikipedia" title="English Wikipedia">English Wikipedia</a></div></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Other names</th><td class="infobox-data">Microsoft Internet Explorer (versions 1–6)<br/>Windows Internet Explorer (versions 7–9)<br/>IE</td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Programmer" title="Programmer">Original author</a></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Thomas_Reardon" title="Thomas Reardon">Thomas Reardon</a></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Programmer" title="Programmer">Developer</a></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Microsoft" title="Microsoft">Microsoft</a></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Release</th><td class="infobox-data">August<span typeof="mw:Entity"> </span>24, 1995<span class="noprint"><span typeof="mw:Entity">;</span><span typeof="mw:Entity"> </span>31 years ago</span><span style="display:none"><span typeof="mw:Entity"> </span>(<span class="bday dtstart published updated">1995-08-24</span>)</span><sup about="#mwt13" class="mw-ref reference" id="cite_ref-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-1"}}'><a href="#cite_note-1" id="mwEA"><span class="mw-reflink-text" id="mwEQ"><span class="cite-bracket" id="mwEg">[</span>1<span class="cite-bracket" id="mwEw">]</span></span></a></sup> (included with Plus! for Windows 95)</td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Software_engine" title="Software engine">Engines</a></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/MSHTML" title="MSHTML" class="mw-redirect">MSHTML</a> (Trident), <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Chakra_(JScript_engine)" title="Chakra (JScript engine)">Chakra</a></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Operating_system" title="Operating system">Operating system</a></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows" title="Windows" class="mw-redirect">Windows</a> <small>(previously supported: <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/MacOS" title="MacOS">Mac OS X</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Solaris_(operating_system)" title="Solaris (operating system)" class="mw-redirect">Solaris</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/HP-UX" title="HP-UX">HP-UX</a>)</small></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Computing_platform" title="Computing platform">Platform</a></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IA-32" title="IA-32">IA-32</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/X86-64" title="X86-64">x86-64</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/ARMv7" title="ARMv7" class="mw-redirect">ARMv7</a> <small> (previously supported: <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/MIPS_architecture" title="MIPS architecture">MIPS</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/DEC_Alpha" title="DEC Alpha">Alpha</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/PowerPC" title="PowerPC">PowerPC</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/68k" title="68k" class="mw-redirect">68k</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/SPARC" title="SPARC">SPARC</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/PA-RISC" title="PA-RISC">PA-RISC</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Itanium" title="Itanium">Itanium</a>)</small></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Included with</th><td class="infobox-data"><style data-mw-deduplicate="TemplateStyles:r1126788409" typeof="mw:Extension/templatestyles" about="#mwt16" data-mw='{"name":"templatestyles","attrs":{"src":"Plainlist/styles.css"}}'>.mw-parser-output .plainlist ol,.mw-parser-output .plainlist ul{line-height:inherit;list-style:none;margin:0;padding:0}.mw-parser-output .plainlist ol li,.mw-parser-output .plainlist ul li{margin-bottom:0}</style><div class="plainlist ">
<ul><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Microsoft_Plus!" title="Microsoft Plus!">Microsoft Plus!</a> for <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_95" title="Windows 95">Windows 95</a></li>
<li>Windows 95 OSR1 or later</li>
<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_NT_4.0" title="Windows NT 4.0">Windows NT 4.0</a> through <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_10,_version_21H2" title="Windows 10, version 21H2" class="mw-redirect">Windows 10 version 21H2</a></li>
<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Phone_7" title="Windows Phone 7">Windows Phone 7</a> through <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Phone_8.1" title="Windows Phone 8.1">Windows Phone 8.1</a></li>
<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mac_OS_8#Mac_OS_8.1" title="Mac OS 8">Mac OS 8.1</a> through <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Mac_OS_X_10.2" title="Mac OS X 10.2" class="mw-redirect">Mac OS X 10.2</a></li>
