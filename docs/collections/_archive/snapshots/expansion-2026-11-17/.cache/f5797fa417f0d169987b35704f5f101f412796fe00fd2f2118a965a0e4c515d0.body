<th scope="col" colspan="2" style="padding:0 4px; text-align:left;"></th>

<td style="width:250px;"></td>
<th scope="col" colspan="2" style="padding:0 4px; width:1em; text-align:right;"></th>

</tr>
<tr>
<td colspan="2" style="padding-left: 0.4em; padding-right: 0.4em; min-width: 8em;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Android_(operating_system)" title="Android (operating system)">Android</a></td>
<td style="width: 100px; border-left: solid 1px silver; border-right: solid 1px silver;"><div style="background:#A3FFA3;color:inherit; width:72.23%; overflow: hidden;"><span typeof="mw:Entity"> </span></div></td>
<td colspan="2" style="padding-left: 1.2em; padding-right: 0.4em; text-align: right;">72.23%</td>

</tr>
<tr>
<td colspan="2" style="padding-left: 0.4em; padding-right: 0.4em; min-width: 8em;">iOS</td>
<td style="width: 100px; border-left: solid 1px silver; border-right: solid 1px silver;"><div style="background:#A3D3FF;color:inherit; width:27.39%; overflow: hidden;"><span typeof="mw:Entity"> </span></div></td>
<td colspan="2" style="padding-left: 1.2em; padding-right: 0.4em; text-align: right;">27.39%</td>

</tr>
<tr>
<td colspan="2" style="padding-left: 0.4em; padding-right: 0.4em; min-width: 8em;">Other</td>
<td style="width: 100px; border-left: solid 1px silver; border-right: solid 1px silver;"><div style="background:#A3D3FF;color:inherit; width:0.38%; overflow: hidden;"><span typeof="mw:Entity"> </span></div></td>
