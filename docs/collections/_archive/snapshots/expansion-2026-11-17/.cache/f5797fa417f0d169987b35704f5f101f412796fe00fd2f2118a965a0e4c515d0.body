	<div class="pie7" style="background:#FFFFFF;color:#000; transform: rotate(0.93turn)" title="iOS 17 and earlier (7.00%)"></div>
<div class="smooth-pie-border"></div></div>
</div></div></div>
<span class="mw-empty-elt" about="#mwt631" typeof="mw:Transclusion" id="mwBMc" data-mw='{"parts":[{"template":{"target":{"wt":"pie chart\n","href":"./Template:Pie_chart"},"params":{"thumb":{"wt":"right"},"caption":{"wt":"iPad platform usage as measured by the [[App Store (Apple)|App Store]] on June 7, 2026&lt;ref name=\"platformUsage\"/>"},"label1":{"wt":"[[iPadOS 26]]"},"value1":{"wt":"68"},"color1":{"wt":"#F7A379"},"label2":{"wt":"[[iPadOS 18]]"},"value2":{"wt":"17"},"color2":{"wt":"#FACCB1"},"label3":{"wt":"[[iPadOS 17]] and earlier"},"value3":{"wt":"15"},"color3":{"wt":"#FFFFFF"}},"i":0}}]}'><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1374442995" about="#mwt632" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Pie chart/styles.css"}}'/></span><div class="pie-thumb thumb tright" about="#mwt631" id="mwBMg"><div class="thumbinner"><div class="smooth-pie-container" style="">
<div class="smooth-pie-legend-container"><div class="smooth-pie-caption">iPad platform usage as measured by the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/App_Store_(Apple)" title="App Store (Apple)">App Store</a> on June 7, 2026<sup about="#mwt633" class="mw-ref reference" id="cite_ref-platformUsage_185-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"platformUsage"}}'><a href="#cite_note-platformUsage-185" id="mwBMk"><span class="mw-reflink-text" id="mwBMo"><span class="cite-bracket" id="mwBMs">[</span>185<span class="cite-bracket" id="mwBMw">]</span></span></a></sup></div>
<ol class="smooth-pie-legend">
<li><span class="l-color" style="-webkit-print-color-adjust: exact; print-color-adjust: exact;background:#F7A379;color:#000"></span><span class="l-label"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPadOS_26" title="IPadOS 26">iPadOS 26</a> (68.0%)</span></li>
<li><span class="l-color" style="-webkit-print-color-adjust: exact; print-color-adjust: exact;background:#FACCB1;color:#000"></span><span class="l-label"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPadOS_18" title="IPadOS 18">iPadOS 18</a> (17.0%)</span></li>
<li><span class="l-color" style="-webkit-print-color-adjust: exact; print-color-adjust: exact;background:#FFFFFF;color:#000"></span><span class="l-label"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IPadOS_17" title="IPadOS 17">iPadOS 17</a> and earlier (15.0%)</span></li>
</ol>
</div>
<div class="smooth-pie" style="width:200px;height:200px;background:#888;color:#000;-webkit-print-color-adjust: exact; print-color-adjust: exact;" aria-hidden="true">
	<div class="pie50" style="background:#F7A379;color:#000" title="iPadOS 26 (68.0%)"></div>
	<div class="pie50" style="background:#F7A379;color:#000; transform: rotate(0.182turn)" title="iPadOS 26 (68.0%)"></div>
	<div class="pie12-5" style="background:#FACCB1;color:#000; transform: rotate(0.679turn)" title="iPadOS 18 (17.0%)"></div>
	<div class="pie12-5" style="background:#FACCB1;color:#000; transform: rotate(0.726turn)" title="iPadOS 18 (17.0%)"></div>
	<div class="pie12-5" style="background:#FFFFFF;color:#000; transform: rotate(0.849turn)" title="iPadOS 17 and earlier (15.0%)"></div>
