</section><section data-mw-section-id="7" id="mwAQA" aria-labelledby="Reception"><div class="mw-heading mw-heading2"><h2 id="Reception">Reception</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=IPhone_OS_1&amp;action=edit&amp;section=7" title="Edit section: Reception"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
