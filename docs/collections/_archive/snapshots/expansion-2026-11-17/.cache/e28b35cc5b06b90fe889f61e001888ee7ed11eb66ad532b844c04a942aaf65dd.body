<li about="#cite_note-53" id="cite_note-53" data-mw-footnote-number="53"><span class="mw-cite-backlink" id="mwBTY"><a href="#cite_ref-53" rel="mw:referencedBy" id="mwBTc"><span class="mw-linkback-text" id="mwBTg">↑</span></a></span> <span id="mw-reference-text-cite_note-53" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt182" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBTk" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite magazine ","href":"./Template:Cite_magazine"},"params":{"url":{"wt":"https://www.wired.com/2009/02/norwegian-websi/"},"title":{"wt":"Norwegian Websites Declare War on IE 6"},"last":{"wt":"Calore"},"first":{"wt":"Michael"},"date":{"wt":"February 19, 2009"},"magazine":{"wt":"[[Wired (magazine)|Wired]]"},"publisher":{"wt":"[[Condé Nast]]"},"access-date":{"wt":"9 February 2010"},"archive-date":{"wt":"26 April 2009"},"archive-url":{"wt":"https://web.archive.org/web/20090426050753/http://blog.wired.com/business/2009/02/norwegian-websi.html"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite id="CITEREFCalore2009" class="citation magazine cs1" about="#mwt182">Calore, Michael (February 19, 2009). <a rel="mw:ExtLink nofollow" href="https://www.wired.com/2009/02/norwegian-websi/" class="external text" id="mwBTo">"Norwegian Websites Declare War on IE 6"</a>. <i id="mwBTs"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wired_(magazine)" title="Wired (magazine)" id="mwBTw">Wired</a></i>. <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Condé_Nast" title="Condé Nast" id="mwBT0">Condé Nast</a>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20090426050753/http://blog.wired.com/business/2009/02/norwegian-websi.html" class="external text" id="mwBT4">Archived</a> from the original on 26 April 2009<span class="reference-accessdate" id="mwBT8">. Retrieved <span class="nowrap" id="mwBUA">9 February</span> 2010</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Wired&amp;rft.atitle=Norwegian+Websites+Declare+War+on+IE+6&amp;rft.date=2009-02-19&amp;rft.aulast=Calore&amp;rft.aufirst=Michael&amp;rft_id=https%3A%2F%2Fwww.wired.com%2F2009%2F02%2Fnorwegian-websi%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AInternet+Explorer+6" class="Z3988" about="#mwt182" id="mwBUE"></span></span></li>
<li about="#cite_note-54" id="cite_note-54" data-mw-footnote-number="54"><span class="mw-cite-backlink" id="mwBUI"><a href="#cite_ref-54" rel="mw:referencedBy" id="mwBUM"><span class="mw-linkback-text" id="mwBUQ">↑</span></a></span> <span id="mw-reference-text-cite_note-54" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt185" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBUU" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"archive-url":{"wt":"https://archive.today/20090720112341/http://www.comon.dk/nyheder/Danske-medier-lover-doed-over-Internet-Explorer-6-1.138882.html"},"url-status":{"wt":"dead"},"archive-date":{"wt":"20 July 2009"},"url":{"wt":"http://www.comon.dk/nyheder/Danske-medier-lover-doed-over-Internet-Explorer-6-1.138882.html"},"title":{"wt":"Danske medier lover død over Internet Explorer 6"},"last":{"wt":"Nielsen"},"first":{"wt":"Jens"},"date":{"wt":"27 March 2009"},"work":{"wt":"Comon"},"publisher":{"wt":"Computerworld A/S"},"language":{"wt":"da"},"access-date":{"wt":"9 February 2010"}},"i":0}}]}'/><cite id="CITEREFNielsen2009" class="citation web cs1 cs1-prop-foreign-lang-source" about="#mwt185">Nielsen, Jens (27 March 2009). <a rel="mw:ExtLink nofollow" href="http://www.comon.dk/nyheder/Danske-medier-lover-doed-over-Internet-Explorer-6-1.138882.html" class="external text" id="mwBUY">"Danske medier lover død over Internet Explorer 6"</a>. <i id="mwBUc">Comon</i> (in Danish). Computerworld A/S<span class="reference-accessdate" id="mwBUg">. Retrieved <span class="nowrap" id="mwBUk">9 February</span> 2010</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Comon&amp;rft.atitle=Danske+medier+lover+d%C3%B8d+over+Internet+Explorer+6&amp;rft.date=2009-03-27&amp;rft.aulast=Nielsen&amp;rft.aufirst=Jens&amp;rft_id=http%3A%2F%2Fwww.comon.dk%2Fnyheder%2FDanske-medier-lover-doed-over-Internet-Explorer-6-1.138882.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AInternet+Explorer+6" class="Z3988" about="#mwt185" id="mwBUo"></span><span class="cs1-maint citation-comment" about="#mwt185" id="mwBUs"><code class="cs1-code" id="mwBUw">{{<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Template:Cite_web" title="Template:Cite web" id="mwBU0">cite web</a>}}</code>:  CS1 maint: deprecated archival service (<a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Category:CS1_maint:_deprecated_archival_service" title="Category:CS1 maint: deprecated archival service" id="mwBU4">link</a>)</span><link rel="mw:PageProp/Category" href="./Category:CS1_maint:_deprecated_archival_service" about="#mwt185" id="mwBU8"/><link rel="mw:PageProp/Category" href="./Category:CS1_Danish-language_sources_(da)" about="#mwt185" id="mwBVA"/></span></li>
<li about="#cite_note-55" id="cite_note-55" data-mw-footnote-number="55"><span class="mw-cite-backlink" id="mwBVE"><a href="#cite_ref-55" rel="mw:referencedBy" id="mwBVI"><span class="mw-linkback-text" id="mwBVM">↑</span></a></span> <span id="mw-reference-text-cite_note-55" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt189" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBVQ" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web","href":"./Template:Cite_web"},"params":{"last1":{"wt":"Protalinski"},"first1":{"wt":"Emil"},"title":{"wt":"Google&apos;s Orkut starts phasing out support for IE6"},"url":{"wt":"https://arstechnica.com/information-technology/2009/08/googles-orkut-starts-phasing-out-support-for-ie6/"},"website":{"wt":"Ars Technica"},"access-date":{"wt":"2021-10-02"},"language":{"wt":"en"},"date":{"wt":"2009-08-11"},"quote":{"wt":"Last month, Google&apos;s YouTube made a similar move [to deprecate IE6]. As you can see below, however, the order of browsers on the video-sharing website is different: Firefox, Chrome, and IE8. This order actually changes upon every refresh of the page, which is probably the better solution. It&apos;s more important to note that unlike on Orkut, you don&apos;t have to log in to get the warning message on YouTube."},"archive-date":{"wt":"2021-10-02"},"archive-url":{"wt":"https://web.archive.org/web/20211002071552/https://arstechnica.com/information-technology/2009/08/googles-orkut-starts-phasing-out-support-for-ie6/"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite id="CITEREFProtalinski2009" class="citation web cs1" about="#mwt189">Protalinski, Emil (2009-08-11). <a rel="mw:ExtLink nofollow" href="https://arstechnica.com/information-technology/2009/08/googles-orkut-starts-phasing-out-support-for-ie6/" class="external text" id="mwBVU">"Google's Orkut starts phasing out support for IE6"</a>. <i id="mwBVY">Ars Technica</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20211002071552/https://arstechnica.com/information-technology/2009/08/googles-orkut-starts-phasing-out-support-for-ie6/" class="external text" id="mwBVc">Archived</a> from the original on 2021-10-02<span class="reference-accessdate" id="mwBVg">. Retrieved <span class="nowrap" id="mwBVk">2021-10-02</span></span>. <q id="mwBVo">Last month, Google's YouTube made a similar move [to deprecate IE6]. As you can see below, however, the order of browsers on the video-sharing website is different: Firefox, Chrome, and IE8. This order actually changes upon every refresh of the page, which is probably the better solution. It's more important to note that unlike on Orkut, you don't have to log in to get the warning message on YouTube.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Ars+Technica&amp;rft.atitle=Google%27s+Orkut+starts+phasing+out+support+for+IE6&amp;rft.date=2009-08-11&amp;rft.aulast=Protalinski&amp;rft.aufirst=Emil&amp;rft_id=https%3A%2F%2Farstechnica.com%2Finformation-technology%2F2009%2F08%2Fgoogles-orkut-starts-phasing-out-support-for-ie6%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AInternet+Explorer+6" class="Z3988" about="#mwt189" id="mwBVs"></span></span></li>
<li about="#cite_note-56" id="cite_note-56" data-mw-footnote-number="56"><span class="mw-cite-backlink" id="mwBVw"><a href="#cite_ref-56" rel="mw:referencedBy" id="mwBV0"><span class="mw-linkback-text" id="mwBV4">↑</span></a></span> <span id="mw-reference-text-cite_note-56" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt192" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwBV8" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"last1":{"wt":"Warren"},"first1":{"wt":"Tom"},"title":{"wt":"Former Google engineer reveals the secret YouTube plot to kill Internet Explorer 6"},"url":{"wt":"https://www.theverge.com/2019/5/4/18529381/google-youtube-internet-explorer-6-kill-plot-engineer"},"website":{"wt":"The Verge"},"access-date":{"wt":"11 September 2021"},"language":{"wt":"en"},"date":{"wt":"4 May 2019"},"archive-date":{"wt":"11 September 2021"},"archive-url":{"wt":"https://web.archive.org/web/20210911121946/https://www.theverge.com/2019/5/4/18529381/google-youtube-internet-explorer-6-kill-plot-engineer"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite id="CITEREFWarren2019" class="citation web cs1" about="#mwt192">Warren, Tom (4 May 2019). <a rel="mw:ExtLink nofollow" href="https://www.theverge.com/2019/5/4/18529381/google-youtube-internet-explorer-6-kill-plot-engineer" class="external text" id="mwBWA">"Former Google engineer reveals the secret YouTube plot to kill Internet Explorer 6"</a>. <i id="mwBWE">The Verge</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20210911121946/https://www.theverge.com/2019/5/4/18529381/google-youtube-internet-explorer-6-kill-plot-engineer" class="external text" id="mwBWI">Archived</a> from the original on 11 September 2021<span class="reference-accessdate" id="mwBWM">. Retrieved <span 