<td id="mwARg"><span data-sort-value="000000002013-06-26-0000" style="white-space:nowrap" about="#mwt129" typeof="mw:Transclusion" id="mwARk" data-mw='{"parts":[{"template":{"target":{"wt":"dts","href":"./Template:Dts"},"params":{"1":{"wt":"2013-06-26"}},"i":0}}]}'>June 26, 2013</span><sup about="#mwt130" class="mw-ref reference" id="cite_ref-ie11-8.1-preview_35-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"ie11-8.1-preview"}}'><a href="#cite_note-ie11-8.1-preview-35" id="mwARo"><span class="mw-reflink-text" id="mwARs"><span class="cite-bracket" id="mwARw">[</span>35<span class="cite-bracket" id="mwAR0">]</span></span></a></sup></td>
<td id="mwAR4">Windows 8.1 Preview</td>
<td rowspan="2" id="mwAR8"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/WebGL" title="WebGL" id="mwASA">WebGL</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/CSS" title="CSS" id="mwASE">CSS</a> border image, improved <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/JavaScript" title="JavaScript" id="mwASI">JavaScript</a> performance, major update to <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_Explorer_Developer_Tools" title="Internet Explorer Developer Tools" class="mw-redirect" id="mwASM">Internet Explorer Developer Tools</a>,<sup about="#mwt131" class="mw-ref reference" id="cite_ref-ie11-7-preview_37-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"ie11-7-preview"}}'><a href="#cite_note-ie11-7-preview-37" id="mwASQ"><span class="mw-reflink-text" id="mwASU"><span class="cite-bracket" id="mwASY">[</span>37<span class="cite-bracket" id="mwASc">]</span></span></a></sup> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Hardware-accelerated" title="Hardware-accelerated" class="mw-redirect" id="mwASg">hardware-accelerated</a> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/JPEG" title="JPEG" id="mwASk">JPEG</a> decoding,<sup about="#mwt132" class="mw-ref reference" id="cite_ref-PCWord_Bradley_Business_39-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"PCWord Bradley Business"}}'><a href="#cite_note-PCWord_Bradley_Business-39" id="mwASo"><span class="mw-reflink-text" id="mwASs"><span class="cite-bracket" id="mwASw">[</span>39<span class="cite-bracket" id="mwAS0">]</span></span></a></sup> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Closed_captioning" title="Closed captioning" id="mwAS4">closed captioning</a>, HTML5 full screen,<sup about="#mwt133" class="mw-ref reference" id="cite_ref-ghack_Brinkmann_Preview_40-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"ghack Brinkmann Preview"}}'><a href="#cite_note-ghack_Brinkmann_Preview-40" id="mwAS8"><span class="mw-reflink-text" id="mwATA"><span class="cite-bracket" id="mwATE">[</span>40<span class="cite-bracket" id="mwATI">]</span></span></a></sup> HTML5 prerender, HTML5 prefetch
<p id="mwATM"><b id="mwATQ">Windows 8.1 only</b>: cryptography (WebCrypto),<sup about="#mwt134" class="mw-ref reference" id="cite_ref-ie11-7-preview_37-2" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"ie11-7-preview"}}'><a href="#cite_note-ie11-7-preview-37" id="mwATU"><span class="mw-reflink-text" id="mwATY"><span class="cite-bracket" id="mwATc">[</span>37<span class="cite-bracket" id="mwATg">]</span></span></a></sup> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Adaptive_bitrate_streaming" title="Adaptive bitrate streaming" id="mwATk">adaptive bitrate streaming</a> (Media Source Extensions),<sup about="#mwt135" class="mw-ref reference" id="cite_ref-BetaNews_Williams_DevPreview_41-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"BetaNews Williams DevPreview"}}'><a href="#cite_note-BetaNews_Williams_DevPreview-41" id="mwATo"><span class="mw-reflink-text" id="mwATs"><span class="cite-bracket" id="mwATw">[</span>41<span class="cite-bracket" id="mwAT0">]</span></span></a></sup> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Encrypted_Media_Extensions" title="Encrypted Media Extensions" id="mwAT4">Encrypted Media Extensions</a>,<sup about="#mwt136" class="mw-ref reference" id="cite_ref-ghack_Brinkmann_Preview_40-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"ghack Brinkmann Preview"}}'><a href="#cite_note-ghack_Brinkmann_Preview-40" id="mwAT8"><span class="mw-reflink-text" id="mwAUA"><span class="cite-bracket" id="mwAUE">[</span>40<span class="cite-bracket" id="mwAUI">]</span></span></a></sup> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/SPDY" title="SPDY" id="mwAUM">SPDY v3</a><sup about="#mwt137" class="mw-ref reference" id="cite_ref-techcrunch-spdy_21-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"techcrunch-spdy"}}'><a href="#cite_note-techcrunch-spdy-21" id="mwAUQ"><span class="mw-reflink-text" id="mwAUU"><span class="cite-bracket" id="mwAUY">[</span>21<span class="cite-bracket" id="mwAUc">]</span></span></a></sup></p></td></tr>

