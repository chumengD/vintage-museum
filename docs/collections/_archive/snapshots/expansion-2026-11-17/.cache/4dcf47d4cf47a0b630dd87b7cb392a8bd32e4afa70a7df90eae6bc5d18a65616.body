<li about="#cite_note-3" id="cite_note-3" data-mw-footnote-number="3"><span class="mw-cite-backlink" id="mwASc"><a href="#cite_ref-3" rel="mw:referencedBy" id="mwASg"><span class="mw-linkback-text" id="mwASk">↑</span></a></span> <span id="mw-reference-text-cite_note-3" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt20" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwASo" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://www.xunlei.com/v2018/dist/aboutusdetail.html"},"title":{"wt":"Lianxi women"},"script-title":{"wt":"zh:联系我们"},"trans-title":{"wt":"Contact Us"},"publisher":{"wt":"Xunlei"},"access-date":{"wt":"2020-06-13"},"quote":{"wt":"深圳总部 地址：深圳市南山区粤海街道高新区社区科技南路18号深圳湾科技生态园12栋B座21层至23层"}},"i":0}}]}'/><cite class="citation web cs1 cs1-prop-script" about="#mwt20" id="mwASs"><a rel="mw:ExtLink nofollow" href="https://www.xunlei.com/v2018/dist/aboutusdetail.html" class="external text" id="mwASw">"Lianxi women" <bdi lang="zh" id="mwAS0">联系我们</bdi></a> <span typeof="mw:Entity" id="mwAS4">[</span>Contact Us<span typeof="mw:Entity" id="mwAS8">]</span>. Xunlei<span class="reference-accessdate" id="mwATA">. Retrieved <span class="nowrap" id="mwATE">13 June</span> 2020</span>. <q id="mwATI">深圳总部 地址：深圳市南山区粤海街道高新区社区科技南路18号深圳湾科技生态园12栋B座21层至23层</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Lianxi+women+%E8%81%94%E7%B3%BB%E6%88%91%E4%BB%AC&amp;rft.pub=Xunlei&amp;rft_id=https%3A%2F%2Fwww.xunlei.com%2Fv2018%2Fdist%2Faboutusdetail.html&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AXunlei" class="Z3988" about="#mwt20" id="mwATM"></span><link rel="mw:PageProp/Category" href="./Category:CS1_uses_Chinese-language_script_(zh)" about="#mwt20" id="mwATQ"/></span></li>
<li about="#cite_note-4" id="cite_note-4" data-mw-footnote-number="4"><span class="mw-cite-backlink" id="mwATU"><a href="#cite_ref-4" rel="mw:referencedBy" id="mwATY"><span class="mw-linkback-text" id="mwATc">↑</span></a></span> <span id="mw-reference-text-cite_note-4" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt23" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwATg" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web ","href":"./Template:Cite_web"},"params":{"url":{"wt":"http://www.usenet.tk/xunlei-chinese-file-sharing-platform-struggles-piracy/"},"title":{"wt":"Xunlei: Chinese File Sharing Platform Struggles with Piracy"},"access-date":{"wt":"25 January 2017"},"archive-date":{"wt":"14 February 2017"},"archive-url":{"wt":"https://web.archive.org/web/20170214024527/http://www.usenet.tk/xunlei-chinese-file-sharing-platform-struggles-piracy/"},"url-status":{"wt":"dead"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt23" id="mwATk"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20170214024527/http://www.usenet.tk/xunlei-chinese-file-sharing-platform-struggles-piracy/" class="external text" id="mwATo">"Xunlei: Chinese File Sharing Platform Struggles with Piracy"</a>. Archived from <a rel="mw:ExtLink nofollow" href="https://www.usenet.tk/xunlei-chinese-file-sharing-platform-struggles-piracy/" class="external text" data-mw-original-href="http://www.usenet.tk/xunlei-chinese-file-sharing-platform-struggles-piracy/" id="mwATs">the original</a> on 14 February 2017<span class="reference-accessdate" id="mwATw">. Retrieved <span class="nowrap" id="mwAT0">25 January</span> 2017</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Xunlei%3A+Chinese+File+Sharing+Platform+Struggl