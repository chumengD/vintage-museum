dtstart published updated">29 September 2022</span>)</span></td></tr><tr><th scope="row" class="infobox-label">Android</th><td class="infobox-data">7.53.0.8245<sup about="#mwt76" class="mw-ref reference" id="cite_ref-wikidata-084ed02b9ea030c1da2ac1d3bb709ce4ee446467-v22_16-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"wikidata-084ed02b9ea030c1da2ac1d3bb709ce4ee446467-v22"},"body":{"id":"mw-reference-text-cite_note-wikidata-084ed02b9ea030c1da2ac1d3bb709ce4ee446467-v22-16"}}'><a href="#cite_note-wikidata-084ed02b9ea030c1da2ac1d3bb709ce4ee446467-v22-16" id="mwYQ"><span class="mw-reflink-text" id="mwYg"><span class="cite-bracket" id="mwYw">[</span>16<span class="cite-bracket" id="mwZA">]</span></span></a></sup><span typeof="mw:Entity"> </span><span class="mw-valign-text-top" typeof="mw:File/Frameless" data-mw='{"caption":"Edit this on Wikidata"}'><a href="https://www.wikidata.org/wiki/Q1456845?uselang=en#P348" title="Edit this on Wikidata"><img resource="https://en.wikipedia.org/wiki/File:OOjs_UI_icon_edit-ltr-progressive.svg" src="//thumb.wikimedia.org/wikipedia/en/thumb/8/8a/OOjs_UI_icon_edit-ltr-progressive.svg/20px-OOjs_UI_icon_edit-ltr-progressive.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" alt="Edit this on Wikidata" data-file-width="20" data-file-height="20" data-file-type="drawing" height="10" width="10" class="mw-file-element"/></a></span><sup about="#mwt81" class="mw-ref reference" id="cite_ref-17" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-17"}}'><a href="#cite_note-17" id="mwZQ"><span class="mw-reflink-text" id="mwZg"><span class="cite-bracket" id="mwZw">[</span>17<span class="cite-bracket" id="mwaA">]</span></span></a></sup> / 11 October 2022<span class="noprint"><span typeof="mw:Entity">;</span><span typeof="mw:Entity"> </span>4 years ago</span><span style="display:none"><span typeof="mw:Entity"> </span>(<span class="bday dtstart published updated">11 October 2022</span>)</span></td></tr></tbody></table>
