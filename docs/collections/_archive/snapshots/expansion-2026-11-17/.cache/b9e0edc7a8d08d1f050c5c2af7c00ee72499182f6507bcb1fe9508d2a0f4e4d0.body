					</div>
					
					<div id="mw-content-text" class="mw-body-content"><div class="mw-content-ltr mw-parser-output" lang="en" dir="ltr" data-mw-parsoid-version="0.25.0.0-alpha1" data-mw-html-version="2.8.0"><section data-mw-section-id="0" id="mwAQ"><div class="shortdescription nomobile noexcerpt noprint searchaux" style="display:none" about="#mwt1" typeof="mw:Transclusion" id="mwAg" data-mw='{"parts":[{"template":{"target":{"wt":"Short description","href":"./Template:Short_description"},"params":{"1":{"wt":"Web browser for Windows released in 2009"}},"i":0}}]}'>Web browser for Windows released in 2009</div><span class="mw-empty-elt" about="#mwt1"><link rel="mw:PageProp/Category" href="./Category:Articles_with_short_description"/><link rel="mw:PageProp/Category" href="./Category:Short_description_is_different_from_Wikidata"/></span>
<span class="mw-empty-elt" about="#mwt2" typeof="mw:Transclusion" id="mwAw" data-mw='{"parts":[{"template":{"target":{"wt":"More citations needed","href":"./Template:More_citations_needed"},"params":{"date":{"wt":"May 2024"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1384556748" typeof="mw:Extension/templatestyles" about="#mwt3" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Message box/ambox.css"},"body":{"extsrc":""}}'>.mw-parser-output .ambox{border:1px solid var(--border-color-base,#a2a9b1);border-left:10px solid #36c;background-color:var(--background-color-neutral-subtle,#f8f9fa);box-sizing:border-box}.mw-parser-output .ambox+.mw-empty-elt+.ambox,.mw-parser-output .ambox+.mw-empty-elt+.mw-empty-elt+.ambox,.mw-parser-output .ambox+.mw-empty-elt+.mw-empty-elt+.mw-empty-elt+.ambox{margin-top:-1px}html body.mediawiki .mw-parser-output .ambox.mbox-small-left{margin:4px 1em 4px 0;overflow:hidden;width:238px;border-collapse:collapse;font-size:88%;line-height:1.25em}.mw-parser-output .ambox-speedy{border-left-color:#b32424;background-color:#fee7e6}.mw-parser-output .ambox-delete{border-left-color:#b32424}.mw-parser-output .ambox-content{border-left-color:#f28500}.mw-parser-output .ambox-style{border-left-color:#fc3}.mw-parser-output .ambox-move{border-left-color:#9932cc}.mw-parser-output .ambox-protection{border-left-color:var(--border-color-base,#a2a9b1)}.mw-parser-output .ambox .mbox-text{border:none;padding:0.25em 0.5em;width:100%}.mw-parser-output .ambox .mbox-image{border:none;padding:2px 0 2px 0.5em;text-align:center}.mw-parser-output .ambox .mbox-imageright{border:none;padding:2px 0.5em 2px 0;text-align:center}.mw-parser-output .ambox .mbox-empty-cell{border:none;padding:0;width:1px}.mw-parser-output .ambox .mbox-image-div{width:52px}@media(min-width:720px){.mw-parser-output .ambox{margin:0 10%}}@media print{body.ns-0 .mw-parser-output .ambox{display:none!important}}@media screen{html.skin-theme-clientpref-night .mw-parser-output .ambox-speedy{background-color:#310402}}@media screen and (prefers-color-scheme:dark){html.skin-theme-clientpref-os .mw-parser-output .ambox-speedy{background-color:#310402}}</style></span><table class="box-More_citations_needed plainlinks metadata ambox ambox-content ambox-Refimprove" role="presentation" about="#mwt2"><tbody><tr><td class="mbox-image"><div class="mbox-image-div"><span typeof="mw:File"><a href="https://en.wikipedia.org/wiki/File:Question_book-new.svg" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Question_book-new.svg" src="//thumb.wikimedia.org/wikipedia/en/thumb/9/99/Question_book-new.svg/60px-Question_book-new.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/en/thumb/9/99/Question_book-new.svg/120px-Question_book-new.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" alt="icon" data-file-width="512" data-file-height="399" data-file-type="drawing" height="39" width="50" class="mw-file-element"/></a></span></div></td><td class="mbox-text"><div class="mbox-text-span">This article <b>needs <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wikipedia:Verifiability" title="Wikipedia:Verifiability">more citations</a></b>.<span class="hide-when-compact"> Please help <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Special:EditPage/Internet_Explorer_8" title="Special:EditPage/Internet Explorer 8">improve this article</a> by <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Help:Referencing_for_beginners" title="Help:Referencing for beginners">adding citations to reliable sources</a>. Unsourced material may be challenged and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wikipedia:Verifiability#Burden_of_evidence" title="Wikipedia:Verifiability">removed</a>.<br/><small><span class="plainlinks"><i>Find sources:</i><span typeof="mw:Entity"> </span><a rel="mw:ExtLink nofollow" href="https://www.google.com/search?as_eq=wikipedia&amp;q=%22Internet+Explorer+8%22" class="external text">"Internet Explorer 8"</a><span typeof="mw:Entity"> </span>–<span typeof="mw:Entity"> </span><a rel="mw:ExtLink nofollow" href="https://www.google.com/search?tbm=nws&amp;q=%22Internet+Explorer+8%22+-wikipedia&amp;tbs=ar:1" class="external text">news</a> <b>·</b> <a rel="mw:ExtLink nofollow" href="https://www.google.com/search?&amp;q=%22Internet+Explorer+8%22&amp;tbs=bkt:s&amp;tbm=bks" class="external text">newspapers</a> <b>·</b> <a rel="mw:ExtLink nofollow" href="https://www.google.com/search?tbs=bks:1&amp;q=%22Internet+Explorer+8%22+-wikipedia" class="external text">books</a> <b>·</b> <a rel="mw:ExtLink nofollow" href="https://scholar.google.com/scholar?q=%22Internet+Explorer+8%22" class="external text">scholar</a> <b>·</b> <a rel="mw:ExtLink nofollow" href="https://www.jstor.org/action/doBasicSearch?Query=%22Internet+Explorer+8%22&amp;acc=on&amp;wc=on" class="external text">JSTOR</a></span></small></span>  <span class="date-container"><i>(<span class="date">May 2024</span>)</i></span><span class="hide-when-compact"><i> (<small><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Help:Maintenance_template_removal" title="Help:Maintenance template removal">Learn how and when to remove this message</a></small>)</i></span></div></td></tr></tbody></table><span class="mw-empty-elt" about="#mwt2"><link rel="mw:PageProp/Category" href="./Category:Articles_needing_additional_references_from_May_2024"/><link rel="mw:PageProp/Category" href="./Category:All_articles_needing_additional_references"/></span>
<span class="mw-empty-elt" about="#mwt4" typeof="mw:Transclusion" id="mwBA" data-mw='{"parts":[{"template":{"target":{"wt":"Infobox software\n","href":"./Template:Infobox_software"},"params":{"name":{"wt":"Internet Explorer 8"},"logo":{"wt":"Internet Explorer 7 and 8 logo.svg"},"logo size":{"wt":"70px"},"screenshot":{"wt":"Internet Explorer 8.png"},"caption":{"wt":"Screenshot of Internet Explorer 8"},"collapsible":{"wt":""},"author":{"wt":""},"developer":{"wt":"[[Microsoft]]"},"released":{"wt":"{{Start date and age|2009|3|19}}"},"latest release version":{"wt":"Service Pack 1 (8.00.7601.17514)"},"latest release date":{"wt":"{{Start date and age|2011|2|22}}"},"discontinued":{"wt":"{{End date and age|2016|1|12}}"},"programming language":{"wt":""},"operating system":{"wt":"{{Plainlist|\n* [[Windows XP]] SP2 or later\n* [[Windows XP Professional x64 Edition|Windows XP x64 Edition]] SP2\n* [[Windows Server 2003]] SP2\n* [[Windows Vista]]\n* [[Windows Server 2008]]&lt;ref name=\"sys-req\" />\n}}"},"included with":{"wt":"[[Windows 7]]&lt;br>[[Windows Server 2008 R2]]&lt;ref name=\"KB2398632\"/>"},"engine":{"wt":"[[MSHTML]] 4.0"},"platform":{"wt":"cf. [[#System requirements|§ system requirements]]"},"size":{"wt":""},"language":{"wt":""},"genre":{"wt":"[[Web browser]]&lt;br />[[Feed aggregator|Aggregator]]&lt;br />[[File Transfer Protocol|FTP client]]"},"license":{"wt":"[[proprietary software|Proprietary]], [[end-user license agreement|requires]] Windows license"},"website":{"wt":"{{URL|1=https://web.archive.org/web/20090320113107/http://www.microsoft.com/windows/internet-explorer/default.aspx|2=Internet Explorer 8}} (archived at [[Wayback Machine]])"},"standard":{"wt":""},"AsOf":{"wt":""},"replaces":{"wt":"[[Internet Explorer 7]] (2006)"},"replaced_by":{"wt":"[[Internet Explorer 9]] (2011)"}},"i":0}}]}'><style data-mw-deduplicate="TemplateStyles:r1385617415" typeof="mw:Extension/templatestyles" about="#mwt5" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/st