<td id="mwA20"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_XP_x64_Edition" title="Windows XP x64 Edition" class="mw-redirect" id="mwA24">Windows XP x64 Edition</a></td><td id="mwA28">SP2 only</td><td id="mwA3A"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/X64" title="X64" class="mw-redirect" id="mwA3E">x64</a><sup about="#mwt341" class="mw-ref reference" id="cite_ref-Server2k3-64_89-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Server2k3-64"}}'><a href="#cite_note-Server2k3-64-89" id="mwA3I"><span class="mw-reflink-text" id="mwA3M"><span class="cite-bracket" id="mwA3Q">[</span>89<span class="cite-bracket" id="mwA3U">]</span></span></a></sup></td><td id="mwA3Y">128 MB</td></tr>
