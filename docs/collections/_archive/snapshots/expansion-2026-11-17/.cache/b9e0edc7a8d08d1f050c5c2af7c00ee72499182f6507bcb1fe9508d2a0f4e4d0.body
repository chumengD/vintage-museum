="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/en/thumb/9/9a/Internet_Explorer_7_and_8_logo.svg/250px-Internet_Explorer_7_and_8_logo.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="324" data-file-height="308" data-file-type="drawing" height="67" width="70" class="mw-file-element"/></a></span></td></tr><tr><td colspan="2" class="infobox-image logo"><span class="mw-default-size" typeof="mw:File/Frameless"><a href="https://en.wikipedia.org/wiki/File:Internet_Explorer_8.png" class="mw-file-description"><img resource="https://en.wikipedia.org/wiki/File:Internet_Explorer_8.png" src="//thumb.wikimedia.org/wikipedia/en/thumb/e/eb/Internet_Explorer_8.png/250px-Internet_Explorer_8.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//upload.wikimedia.org/wikipedia/en/e/eb/Internet_Explorer_8.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x" data-file-width="404" data-file-height="247" data-file-type="bitmap" height="153" width="250" class="mw-file-element mw-file-upright" style="--mw-file-upright: 1"/></a></span><div class="infobox-caption">Screenshot of Internet Explorer 8</div></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Programmer" title="Programmer">Developer</a></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Microsoft" title="Microsoft">Microsoft</a></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Release</th><td class="infobox-data">March<span typeof="mw:Entity"> </span>19, 2009<span class="noprint"><span typeof="mw:Entity">;</span><span typeof="mw:Entity"> </span>17 years ago</span><span style="display:none"><span typeof="mw:Entity"> </span>(<span class="bday dtstart published updated">2009-03-19</span>)</span></td></tr><tr class="infobox-hiddenrow" style="display: none;"><td colspan="2" class="infobox-full-data"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1385617415" about="#mwt6" typeof="mw:Extension/templatestyles" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Infobox/styles.css"},"body":{"extsrc":""}}'/></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Software_release_life_cycle" title="Software release life cycle">Stable release</a></th><td class="infobox-data"><div style="margin:0px;">Service Pack 1 (8.00.7601.17514)
   / February<span typeof="mw:Entity"> </span>22, 2011<span class="noprint"><span typeof="mw:Entity">;</span><span typeof="mw:Entity"> </span>15 years ago</span><span style="display:none"><span typeof="mw:Entity"> </span>(<span class="bday dtstart published updated">2011-02-22</span>)</span></div></td></tr><tr style="display:none"><td colspan="2">
</td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Software_engine" title="Software engine">Engine</a></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/MSHTML" title="MSHTML" class="mw-redirect">MSHTML</a> 4.0</td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Operating_system" title="Operating system">Operating system</a></th><td class="infobox-data"><style data-mw-deduplicate="TemplateStyles:r1126788409" typeof="mw:Extension/templatestyles" about="#mwt7" data-mw='{"name":"templatestyles","attrs":{"src":"Plainlist/styles.css"}}'>.mw-parser-output .plainlist ol,.mw-parser-output .plainlist ul{line-height:inherit;list-style:none;margin:0;padding:0}.mw-parser-output .plainlist ol li,.mw-parser-output .plainlist ul li{margin-bottom:0}</style><div class="plainlist ">
<ul><li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_XP" title="Windows XP">Windows XP</a> SP2 or later</li>
<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_XP_Professional_x64_Edition" title="Windows XP Professional x64 Edition">Windows XP x64 Edition</a> SP2</li>
<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Server_2003" title="Windows Server 2003">Windows Server 2003</a> SP2</li>
<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Vista" title="Windows Vista">Windows Vista</a></li>
<li><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Server_2008" title="Windows Server 2008">Windows Server 2008</a><sup about="#mwt8" class="mw-ref reference" id="cite_ref-sys-req_1-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"sys-req"}}'><a href="#cite_note-sys-req-1" id="mwBQ"><span class="mw-reflink-text" id="mwBg"><span class="cite-bracket" id="mwBw">[</span>1<span class="cite-bracket" id="mwCA">]</span></span></a></sup></li></ul>

</div></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Computing_platform" title="Computing platform">Platform</a></th><td class="infobox-data">cf. <a rel="mw:WikiLink" href="#System_requirements" class="mw-selflink-fragment">§ system requirements</a></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Included with</th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_7" title="Windows 7">Windows 7</a><br/><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Server_2008_R2" title="Windows Server 2008 R2">Windows Server 2008 R2</a><sup about="#mwt10" class="mw-ref reference" id="cite_ref-KB2398632_2-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"KB2398632"}}'><a href="#cite_note-KB2398632-2" id="mwCQ"><span class="mw-reflink-text" id="mwCg"><span class="cite-bracket" id="mwCw">[</span>2<span class="cite-bracket" id="mwDA">]</span></span></a></sup></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Predecessor</th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_Explorer_7" title="Internet Explorer 7">Internet Explorer 7</a> (2006)</td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Successor</th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_Explorer_9" title="Internet Explorer 9">Internet Explorer 9</a> (2011)</td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Software_categories#Categorization_approaches" title="Software categories">Type</a></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Web_browser" title="Web browser">Web browser</a><br/><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Feed_aggregator" title="Feed aggregator" class="mw-redirect">Aggregator</a><br/><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/File_Transfer_Protocol" title="File Transfer Protocol">FTP client</a></td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Software_license" title="Software license">License</a></th><td class="infobox-data"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Proprietary_software" title="Proprietary software">Proprietary</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/End-user_license_agreement" title="End-user license agreement">requires</a> Windows license</td></tr><tr><th scope="row" class="infobox-label" style="white-space: nowrap;">Website</th><td class="infobox-data"><span class="url"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20090320113107/http://www.microsoft.com/windows/internet-explorer/default.aspx" class="external text">Internet Explorer 8</a></span> (archived at <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Wayback_Machine" title="Wayback Machine">Wayback Machine</a>)</td></tr></tbody></table><span about="#mwt4"> </span>
<p id="mwDQ"><b id="mwDg">Windows Internet Explorer</b> <b id="mwDw">8</b> (<b id="mwEA">IE8</b>) is<!--Do NOT change to "was". This violates [[MOS:TENSE]], which specifies that all articles on products are written in present tense, even if discontinued.--> a major version of the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_Explorer" title="Internet Explorer" id="mwEQ">Internet Explorer</a> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Web_browser" title="Web browser" id="mwEg">web browser</a> for <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows" title="Windows" class="mw-redirect" id="mwEw">Windows</a> released by <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Microsoft" title="Microsoft" id="mwFA">Microsoft</a> on March 19, 2009 and is the successor to Internet Explorer 7. It was the default browser on <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_7" title="Windows 7" id="mwFQ">Windows 7</a> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Server_2008_R2" title="Windows Server 2008 R2" id="mwFg">Windows Server 2008 R2</a>.<sup about="#mwt14" class="mw-ref reference" id="cite_ref-3" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-3"}}'><a href="#cite_note-3" id="mwFw"><span class="mw-reflink-text" id="mwGA"><span class="cite-bracket" id="mwGQ">[</span>3<span class="cite-bracket" id="mwGg">]</span></span></a></sup></p>

<p id="mwGw">It is the first version of Internet Explorer to pass the <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Acid2" title="Acid2" id="mwHA">Acid2</a> test,<sup about="#mwt17" class="mw-ref reference" id="cite_ref-4" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-4"}}'><a href="#cite_note-4" id="mwHQ"><span class="mw-reflink-text" id="mwHg"><span class="cite-bracket" id="mwHw">[</span>4<span class="cite-bracket" id="mwIA">]</span></span></a></sup> the last of the major browsers to do so, though In the later <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Acid3" title="Acid3" id="mwIQ">Acid3</a> Test, it scores 24/100. It is also the first version of Internet Explorer to include <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Web_development_tools" title="Web development tools" id="mwIg">web development tools</a>, as previous versions of Internet Explorer never had tools to develop websites.<sup about="#mwt18" class="mw-ref reference" id="cite_ref-:0_5-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":":0"}}'><a href="#cite_note-:0-5" id="mwIw"><span class="mw-reflink-text" id="mwJA"><span class="cite-bracket" id="mwJQ">[</span>5<span class="cite-bracket" id="mwJg">]</span></span></a></sup> Additionally, it is the first version of Internet Explorer to feature a <a rel="mw:WikiLink" href="#Compatibility_View_mode" class="mw-selflink-fragment" id="mwJw">Compatibility View mode</a> to optionally emulate older versions' rendering behavior, and has color-coded <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Tabbed_browsing" title="Tabbed browsing" class="mw-redirect" id="mwKA">tab</a> groups where links opened in new tabs share the color of the website they originated from.<sup about="#mwt21" class="mw-ref reference" id="cite_ref-6" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-6"}}'><a href="#cite_note-6" id="mwKQ"><span class="mw-reflink-text" id="mwKg"><span class="cite-bracket" id="mwKw">[</span>6<span class="cite-bracket" id="mwLA">]</span></span></a></sup> According to Microsoft, security, ease of use, and improvements in <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/RSS" title="RSS" id="mwLQ">RSS</a>, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Cascading_Style_Sheets" title="Cascading Style Sheets" class="mw-redirect" id="mwLg">CSS</a>, and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Ajax_(programming)" title="Ajax (programming)" id="mwLw">Ajax</a> support were its priorities for IE8.<sup about="#mwt24" class="mw-ref reference" id="cite_ref-7" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-7"}}'><a href="#cite_note-7" id="mwMA"><span class="mw-reflink-text" id="mwMQ"><span class="cite-bracket" id="mwMg">[</span>7<span class="cite-bracket" id="mwMw">]</span></span></a></sup><sup about="#mwt27" class="mw-ref reference" id="cite_ref-IE8Hints_8-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"IE8Hints"},"body":{"id":"mw-reference-text-cite_note-IE8Hints-8"}}'><a href="#cite_note-IE8Hints-8" id="mwNA"><span class="mw-reflink-text" id="mwNQ"><span class="cite-bracket" id="mwNg">[</span>8<span class="cite-bracket" id="mwNw">]</span></span></a></sup></p>

<p id="mwOA">It is the last version of Internet Explorer to run on <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_XP" title="Windows XP" id="mwOQ">Windows XP</a> SP2+, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_XP_Professional_x64_Edition" title="Windows XP Professional x64 Edition" id="mwOg">Windows XP x64 Edition</a> SP2, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Server_2003" title="Windows Server 2003" id="mwOw">Windows Server 2003</a> SP2, <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Vista" title="Windows Vista" id="mwPA">Windows Vista</a> RTM through SP1 and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Server_2008" title="Windows Server 2008" id="mwPQ">Windows Server 2008</a> RTM. It is the final <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Itanium" title="Itanium" id="mwPg">Itanium</a> version of Internet Explorer as well, although it is only available as pre-installed in the Itanium edition of Windows Server 2008 R2.<sup about="#mwt30" class="mw-ref reference" id="cite_ref-9" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-9"}}'><a href="#cite_note-9" id="mwPw"><span class="mw-reflink-text" id="mwQA"><span class="cite-bracket" id="mwQQ">[</span>9<span class="cite-bracket" id="mwQg">]</span></span></a></sup><sup about="#mwt33" class="mw-ref reference" id="cite_ref-10" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-10"}}'><a href="#cite_note-10" id="mwQw"><span class="mw-reflink-text" id="mwRA"><span class="cite-bracket" id="mwRQ">[</span>10<span class="cite-bracket" id="mwRg">]</span></span></a></sup> The Itanium version does not support versions earlier than Windows Server 2008 R2. In addition, it is the last version of <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Internet_Explorer" title="Internet Explorer" id="mwRw">Internet Explorer</a> supporting processors without <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Physical_Address_Extension" title="Physical Address Extension" id="mwSA">PAE</a> or <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/SSE2" title="SSE2" id="mwSQ">SSE2</a>.</p>

<meta property="mw:PageProp/toc" id="mwSg" data-mw='{"autoGenerated":true}'/></section><section data-mw-section-id="1" id="mwSw" aria-labelledby="History"><div class="mw-heading mw-heading2"><h2 id="History">History</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Internet_Explorer_8&amp;action=edit&amp;section=1" title="Edit section: History"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<section data-mw-section-id="2" id="mwTA" aria-labelledby="Development"><div class="mw-heading mw-heading3"><h3 id="Development">Development</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Internet_Explorer_8&amp;action=edit&amp;section=2" title="Edit section: Development"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<figure class="mw-default-size" typeof="mw:File/Thumb" id="mwTQ"><a href="https://en.wikipedia.org/wiki/File:Internet_Explorer_8_wordmark_(2005-2011).svg" class="mw-file-description" id="mwTg"><img resource="https://en.wikipedia.org/wiki/File:Internet_Explorer_8_wordmark_(2005-2011).svg" src="//thumb.wikimedia.org/wikipedia/commons/thumb/0/09/Internet_Explorer_8_wordmark_%282005-2011%29.svg/250px-Internet_Explorer_8_wordmark_%282005-2011%29.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail" decoding="async" loading="lazy" srcset="//thumb.wikimedia.org/wikipedia/commons/thumb/0/09/Internet_Explorer_8_wordmark_%282005-2011%29.svg/500px-Internet_Explorer_8_wordmark_%282005-2011%29.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x" data-file-width="220" data-file-height="40" data-file-type="drawing" height="45" width="250" class="mw-file-element" id="mwTw"/></a><figcaption id="mwUA">Browser's wordmark</figcaption></figure>
<p id="mwUQ">Internet Explorer 8 development started in or before March 2006.<sup about="#mwt36" class="mw-ref reference" id="cite_ref-11" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-11"}}'><a href="#cite_note-11" id="mwUg"><span class="mw-reflink-text" id="mwUw"><span class="cite-bracket" id="mwVA">[</span>11<span class="cite-bracket" id="mwVQ">]</span></span></a></sup> In February 2008, Microsoft sent out private invitations for IE8 Beta 1,<sup about="#mwt39" class="mw-ref reference" id="cite_ref-12" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-12"}}'><a href="#cite_note-12" id="mwVg"><span class="mw-reflink-text" id="mwVw"><span class="cite-bracket" id="mwWA">[</span>12<span class="cite-bracket" id="mwWQ">]</span></span></a></sup> and on March 5, 2008, released Beta 1 to the general public,<sup about="#mwt42" class="mw-ref reference" id="cite_ref-IE8_readiness_13-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"IE8 readiness"},"body":{"id":"mw-reference-text-cite_note-IE8_readiness-13"}}'><a href="#cite_note-IE8_readiness-13" id="mwWg"><span class="mw-reflink-text" id="mwWw"><span class="cite-bracket" id="mwXA">[</span>13<span class="cite-bracket" id="mwXQ">]</span></span></a></sup> although with a focus on web developers.<sup about="#mwt45" class="mw-ref reference" id="cite_ref-wsbetareview_14-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"wsbetareview"},"body":{"id":"mw-reference-text-cite_note-wsbetareview-14"}}'><a href="#cite_note-wsbetareview-14" id="mwXg"><span class="mw-reflink-text" id="mwXw"><span class="cite-bracket" id="mwYA">[</span>14<span class="cite-bracket" id="mwYQ">]</span></span></a></sup> The release launched with an <i id="mwYg">Internet Explorer 8 Readiness Toolkit</i> website promoting IE8 <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/White_papers" title="White papers" class="mw-redirect" id="mwYw">white papers</a>, related software tools, and new features in addition to download links to the Beta.<sup about="#mwt46" class="mw-ref reference" id="cite_ref-IE8_readiness_13-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"IE8 readiness"}}'><a href="#cite_note-IE8_readiness-13" id="mwZA"><span class="mw-reflink-text" id="mwZQ"><span class="cite-bracket" id="mwZg">[</span>13<span class="cite-bracket" id="mwZw">]</span></span></a></sup><sup about="#mwt49" class="mw-ref reference" id="cite_ref-msdnie8new_15-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"msdnie8new"},"body":{"id":"mw-reference-text-cite_note-msdnie8new-15"}}'><a href="#cite_note-msdnie8new-15" id="mwaA"><span class="mw-reflink-text" id="mwaQ"><span class="cite-bracket" id="mwag">[</span>15<span class="cite-bracket" id="mwaw">]</span></span></a></sup> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Microsoft_Developer_Network" title="Microsoft Developer Network" id="mwbA">Microsoft Developer Network</a> (MSDN) added new sections detailing new IE8 technology.<sup about="#mwt50" class="mw-ref reference" id="cite_ref-IE8_readiness_13-2" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"IE8 readiness"}}'><a href="#cite_note-IE8_readiness-13" id="mwbQ"><span class="mw-reflink-text" id="mwbg"><span class="cite-bracket" id="mwbw">[</span>13<span class="cite-bracket" id="mwcA">]</span></span></a></sup><sup about="#mwt52" class="mw-ref reference" id="cite_ref-16" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-16"}}'><a href="#cite_note-16" id="mwcQ"><span class="mw-reflink-text" id="mwcg"><span class="cite-bracket" id="mwcw">[</span>16<span class="cite-bracket" id="mwdA">]</span></span></a></sup> Major press focused on a controversy about Version Targeting, and two new features then called <i id="mwdQ">WebSlice</i> and <i id="mwdg">Activities</i>. The readiness toolkit was promoted as something "developers can exploit to make Internet Explorer 8 'light up'."<sup about="#mwt53" class="mw-ref reference" id="cite_ref-IE8_readiness_13-3" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"IE8 readiness"}}'><a href="#cite_note-IE8_readiness-13" id="mwdw"><span class="mw-reflink-text" id="mweA"><span class="cite-bracket" id="mweQ">[</span>13<span class="cite-bracket" id="mweg">]</span></span></a></sup></p>

<p id="mwew">On August 27, 2008, Microsoft made IE8 Beta 2 generally available.<sup about="#mwt56" class="mw-ref reference" id="cite_ref-dlpage_17-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"dlpage"},"body":{"id":"mw-reference-text-cite_note-dlpage-17"}}'><a href="#cite_note-dlpage-17" id="mwfA"><span class="mw-reflink-text" id="mwfQ"><span class="cite-bracket" id="mwfg">[</span>17<span class="cite-bracket" id="mwfw">]</span></span></a></sup> <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/PC_World_(magazine)" title="PC World (magazine)" class="mw-redirect" id="mwgA">PC World</a> noted various Beta 2 features such as InPrivate mode, tab isolation and color-coding, and improved standards and compatibility compared to Internet Explorer 7.<sup about="#mwt59" class="mw-ref reference" id="cite_ref-Mediati2008Aug27_18-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Mediati2008Aug27"},"body":{"id":"mw-reference-text-cite_note-Mediati2008Aug27-18"}}'><a href="#cite_note-Mediati2008Aug27-18" id="mwgQ"><span class="mw-reflink-text" id="mwgg"><span class="cite-bracket" id="mwgw">[</span>18<span class="cite-bracket" id="mwhA">]</span></span></a></sup> Two name changes included <i id="mwhQ">Activities</i> to <i id="mwhg">Accelerators</i>, and the IE7 <i id="mwhw">Phishing filter</i> renamed <i id="mwiA">Safety Filter</i> in the first Beta to <i id="mwiQ">SmartScreen</i>, both accompanied by incremental technical changes as well.<sup about="#mwt60" class="mw-ref reference" id="cite_ref-Mediati2008Aug27_18-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Mediati2008Aug27"}}'><a href="#cite_note-Mediati2008Aug27-18" id="mwig"><span class="mw-reflink-text" id="mwiw"><span class="cite-bracket" id="mwjA">[</span>18<span class="cite-bracket" id="mwjQ">]</span></span></a></sup> By August 2008, the new feature called <i id="mwjg">InPrivate</i> had taken the spotlight.<sup about="#mwt61" class="mw-ref reference" id="cite_ref-Mediati2008Aug27_18-2" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Mediati2008Aug27"}}'><a href="#cite_note-Mediati2008Aug27-18" id="mwjw"><span class="mw-reflink-text" id="mwkA"><span class="cite-bracket" id="mwkQ">[</span>18<span class="cite-bracket" id="mwkg">]</span></span></a></sup></p>

<p id="mwkw">On January 5, 2009, a tool was provided by Microsoft to block the automatic install of Internet Explorer 8 via <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Update" title="Windows Update" id="mwlA">Windows Update</a>.<sup about="#mwt64" class="mw-ref reference" id="cite_ref-19" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-19"}}'><a href="#cite_note-19" id="mwlQ"><span class="mw-reflink-text" id="mwlg"><span class="cite-bracket" id="mwlw">[</span>19<span class="cite-bracket" id="mwmA">]</span></span></a></sup></p>

<p id="mwmQ">IE8 reached general availability on March 19, 2009. A version optimized for Bing and MSN was also available.<sup about="#mwt67" class="mw-ref reference" id="cite_ref-20" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-20"}}'><a href="#cite_note-20" id="mwmg"><span class="mw-reflink-text" id="mwmw"><span class="cite-bracket" id="mwnA">[</span>20<span class="cite-bracket" id="mwnQ">]</span></span></a></sup><sup about="#mwt70" class="mw-ref reference" id="cite_ref-21" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-21"}}'><a href="#cite_note-21" id="mwng"><span class="mw-reflink-text" id="mwnw"><span class="cite-bracket" id="mwoA">[</span>21<span class="cite-bracket" id="mwoQ">]</span></span></a></sup></p>

</section><section data-mw-section-id="3" id="mwog" aria-labelledby="Language_support"><div class="mw-heading mw-heading3"><h3 id="Language_support">Language support</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Internet_Explorer_8&amp;action=edit&amp;section=3" title="Edit section: Language support"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<p id="mwow">Language support (localization) was not complete on release. Internet Explorer 8 was released with 25 languages.<sup about="#mwt71" class="mw-ref reference" id="cite_ref-Internet_Explorer_8_22-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Internet Explorer 8"}}'><a href="#cite_note-Internet_Explorer_8-22" id="mwpA"><span class="mw-reflink-text" id="mwpQ"><span class="cite-bracket" id="mwpg">[</span>22<span class="cite-bracket" id="mwpw">]</span></span></a></sup> This grew up to 63 for 32-bit in June 2009.<sup about="#mwt74" class="mw-ref reference" id="cite_ref-23" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{},"body":{"id":"mw-reference-text-cite_note-23"}}'><a href="#cite_note-23" id="mwqA"><span class="mw-reflink-text" id="mwqQ"><span class="cite-bracket" id="mwqg">[</span>23<span class="cite-bracket" id="mwqw">]</span></span></a></sup> Support for additional languages can come pre-installed based on the OS, or downloaded and installed via <i id="mwrA">Multilingual User Interface</i> (MUI) packages.<sup about="#mwt75" class="mw-ref reference" id="cite_ref-blogs.msdn.com_24-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"blogs.msdn.com"}}'><a href="#cite_note-blogs.msdn.com-24" id="mwrQ"><span class="mw-reflink-text" id="mwrg"><span class="cite-bracket" id="mwrw">[</span>24<span class="cite-bracket" id="mwsA">]</span></span></a></sup></p>

</section><section data-mw-section-id="4" id="mwsQ" aria-labelledby="Release_history"><div class="mw-heading mw-heading3"><h3 id="Release_history">Release history</h3><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=Internet_Explorer_8&amp;action=edit&amp;section=4" title="Edit section: Release history"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
