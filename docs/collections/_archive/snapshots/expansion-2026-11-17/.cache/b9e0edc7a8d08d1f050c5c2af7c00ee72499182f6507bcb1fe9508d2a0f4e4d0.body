<td id="mwA3g"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Server_2003" title="Windows Server 2003" id="mwA3k">Windows Server 2003</a></td><td id="mwA3o">SP2 only</td><td id="mwA3s"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IA-32" title="IA-32" id="mwA3w">IA-32</a><sup about="#mwt342" class="mw-ref reference" id="cite_ref-Server2k3-32_90-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Server2k3-32"}}'><a href="#cite_note-Server2k3-32-90" id="mwA30"><span class="mw-reflink-text" id="mwA34"><span class="cite-bracket" id="mwA38">[</span>90<span class="cite-bracket" id="mwA4A">]</span></span></a></sup> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/X64" title="X64" class="mw-redirect" id="mwA4E">x64</a><sup about="#mwt343" class="mw-ref reference" id="cite_ref-Server2k3-64_89-1" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Server2k3-64"}}'><a href="#cite_note-Server2k3-64-89" id="mwA4I"><span class="mw-reflink-text" id="mwA4M"><span class="cite-bracket" id="mwA4Q">[</span>89<span class="cite-bracket" id="mwA4U">]</span></span></a></sup></td><td id="mwA4Y">64 MB on IA-32, 128 MB on x64</td></tr>
<tr id="mwA4c">
<td id="mwA4g"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Windows_Vista" title="Windows Vista" id="mwA4k">Windows Vista</a></td><td id="mwA4o"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/Release_to_manufacturing" title="Release to manufacturing" class="mw-redirect" id="mwA4s">RTM</a> or later</td><td id="mwA4w"><a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/IA-32" title="IA-32" id="mwA40">IA-32</a><sup about="#mwt344" class="mw-ref reference" id="cite_ref-Vista2k8-32_91-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Vista2k8-32"}}'><a href="#cite_note-Vista2k8-32-91" id="mwA44"><span class="mw-reflink-text" id="mwA48"><span class="cite-bracket" id="mwA5A">[</span>91<span class="cite-bracket" id="mwA5E">]</span></span></a></sup> and <a rel="mw:WikiLink" href="https://en.wikipedia.org/wiki/X64" title="X64" class="mw-redirect" id="mwA5I">x64</a><sup about="#mwt345" class="mw-ref reference" id="cite_ref-Vista2k8-64_92-0" rel="dc:references" typeof="mw:Extension/ref" data-mw='{"name":"ref","attrs":{"name":"Vista2k8-64"}}'><a href="#cite_note-Vista2k8-64-92" id="mwA5M"><span class="mw-reflink-text" id="mwA5Q"><span class="cite-bracket" id="mwA5U">[</span>92<span class="cite-bracket" id="mwA5Y">]</span></span></a></sup></td><td id="mwA5c">512 MB</td></tr>
