te=2016-03-28&amp;rft_id=https%3A%2F%2Fwww.makeuseof.com%2Ftag%2Fandroid-really-open-source-matter%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAndroid+%28operating+system%29" class="Z3988" about="#mwt29" id="mwD6A"></span></span></li>
<li about="#cite_note-7" id="cite_note-7" data-mw-footnote-number="7"><span class="mw-cite-backlink" id="mwD6E"><a href="#cite_ref-7" rel="mw:referencedBy" id="mwD6I"><span class="mw-linkback-text" id="mwD6M">↑</span></a></span> <span id="mw-reference-text-cite_note-7" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt32" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwD6Q" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"Cite web","href":"./Template:Cite_web"},"params":{"url":{"wt":"https://www.android.com/gms/"},"title":{"wt":"Android – Google Mobile Services"},"website":{"wt":"Android"},"quote":{"wt":"While the Android Open Source Project (AOSP) provides common, device-level functionalities such as email and calling, GMS is not part of AOSP. GMS is only available through a license with Google [..] We ask GMS partners to pass a simple compatibility test and adhere to our compatibility requirements for their Android devices."},"access-date":{"wt":"October 21, 2018"},"archive-date":{"wt":"February 9, 2018"},"archive-url":{"wt":"https://web.archive.org/web/20180209174000/https://www.android.com/gms/"},"url-status":{"wt":"live"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt32" id="mwD6U"><a rel="mw:ExtLink nofollow" href="https://www.android.com/gms/" class="external text" id="mwD6Y">"Android – Google Mobile Services"</a>. <i id="mwD6c">Android</i>. <a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20180209174000/https://www.android.com/gms/" class="external text" id="mwD6g">Archived</a> from the original on February 9, 2018<span class="reference-accessdate" id="mwD6k">. Retrieved <span class="nowrap" id="mwD6o">October 21,</span> 2018</span>. <q id="mwD6s">While the Android Open Source Project (AOSP) provides common, device-level functionalities such as email and calling, GMS is not part of AOSP. GMS is only available through a license with Google [..] We ask GMS partners to pass a simple compatibility test and adhere to our compatibility requirements for their Android devices.</q></cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=unknown&amp;rft.jtitle=Android&amp;rft.atitle=Android+%E2%80%93+Google+Mobile+Services&amp;rft_id=https%3A%2F%2Fwww.android.com%2Fgms%2F&amp;rfr_id=info%3Asid%2Fen.wikipedia.org%3AAndroid+%28operating+system%29" class="Z3988" about="#mwt32" id="mwD6w"></span></span></li>
